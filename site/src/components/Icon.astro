---
/**
 * Inline vector icons (24×24, 1.6 stroke, currentColor). Hand-drawn for
 * STATIC — no icon font, no library, ~200 bytes each, crisp at any size.
 */
interface Props {
  name: 'scrap' | 'crusher' | 'console' | 'exit' | 'bell' | 'flashlight' | 'skull' | 'pod' | 'worm' | 'clock' | 'users' | 'weight' | 'bolt' | 'eye';
  class?: string;
  size?: number;
}
const { name, class: cls, size = 24 } = Astro.props;

const P: Record<Props['name'], string> = {
  scrap: '<path d="M4 15l5-9 6 3 5 8-7 3z"/><path d="M9 6l1 7 10 4M10 13l-6 2"/>',
  crusher: '<rect x="4" y="3" width="16" height="5"/><path d="M12 8v4M7 12h10l-2 4H9z"/><path d="M4 21h16M8 21v-3h8v3"/>',
  console: '<rect x="3" y="4" width="18" height="12"/><path d="M7 8h4M7 11h2M14 8l3 3-3 3"/><path d="M8 20h8M12 16v4"/>',
  exit: '<ellipse cx="12" cy="7" rx="8" ry="3"/><path d="M8 7a4 4 0 0 1 8 0"/><path d="M7 10l-2 10M17 10l2 10M10 12v8M14 12v8" opacity=".6"/>',
  bell: '<path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 20a2 2 0 0 0 4 0M12 3v2"/>',
  flashlight: '<path d="M3 10l6-2v8l-6-2z"/><rect x="9" y="8" width="5" height="8"/><path d="M14 9l7-4M14 12h7M14 15l7 4" opacity=".7"/>',
  skull: '<path d="M5 11a7 7 0 0 1 14 0v4l-2 1v3H7v-3l-2-1z"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><path d="M10 19v-2M14 19v-2"/>',
  pod: '<rect x="7" y="3" width="10" height="16" rx="5"/><path d="M7 9h10M10 13h4"/><path d="M5 21h14"/>',
  worm: '<path d="M3 17c3 0 3-6 6-6s3 6 6 6 3-8 6-8"/><circle cx="21" cy="9" r="1.4"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/>',
  users: '<circle cx="9" cy="8" r="3"/><path d="M3 19c0-3 3-5 6-5s6 2 6 5"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14c3 0 5 2 5 4"/>',
  weight: '<path d="M7 8h10l3 12H4z"/><circle cx="12" cy="5" r="2"/><path d="M10 14h4"/>',
  bolt: '<path d="M13 3L5 14h6l-1 7 8-11h-6z"/>',
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
};
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={P[name]}
/>
