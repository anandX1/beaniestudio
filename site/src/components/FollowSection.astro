---
/**
 * Community capture block — every visitor leaves with a channel we can reach
 * again (Discord / YouTube / Roblox group) plus a UTM-tagged share button.
 * No third-party requests, no tracking scripts.
 */
import { SITE, LINKS } from '../site.config';
import { GAME } from '../data/game';

const shareUrl = `${SITE.url}/?utm_source=shared&utm_medium=friend&utm_campaign=beta`;
---

<section class="border-t border-facility-800" aria-label="Community">
  <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6">
    <p class="kicker">Community</p>
    <h2 class="beat mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
      Don't go in alone
    </h2>
    <p class="beat mt-5 max-w-2xl text-facility-300" style="--beat-delay: 100ms">
      A round of STATIC holds up to {GAME.serverSize} players, and it plays best with people you
      know. The Discord is where squads form, bugs get reported and the next update gets decided.
    </p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      <div class="beat panel p-7" style="--beat-delay: 150ms">
        <h3 class="font-display text-lg font-bold uppercase tracking-wide">Discord</h3>
        <p class="mt-3 text-sm leading-relaxed text-facility-300">
          Find a squad, report bugs straight to the developers, and vote on what gets built next:
          modes, rooms, Hunters.
        </p>
        <p class="mt-5">
          <a href={LINKS.discord} rel="noopener" target="_blank" class="btn-primary">Join the Discord <span aria-hidden="true">→</span></a>
        </p>
      </div>

      <div class="beat panel p-7" style="--beat-delay: 220ms">
        <h3 class="font-display text-lg font-bold uppercase tracking-wide">YouTube</h3>
        <p class="mt-3 text-sm leading-relaxed text-facility-300">
          Gameplay Shorts and devlogs from the team. Every video on this site comes from this
          channel.
        </p>
        <p class="mt-5">
          <a href={LINKS.youtube} rel="noopener" target="_blank" class="btn-secondary">Subscribe on YouTube <span aria-hidden="true">→</span></a>
        </p>
      </div>

      <div class="beat panel p-7" style="--beat-delay: 290ms">
        <h3 class="font-display text-lg font-bold uppercase tracking-wide">Roblox group</h3>
        <p class="mt-3 text-sm leading-relaxed text-facility-300">
          Join the Beanie's Studios group on Roblox to get update announcements where you already
          play.
        </p>
        <p class="mt-5">
          <a href={LINKS.roblox} rel="noopener" target="_blank" class="btn-secondary">Join the group <span aria-hidden="true">→</span></a>
        </p>
      </div>

      <div class="beat panel p-7" style="--beat-delay: 360ms">
        <h3 class="font-display text-lg font-bold uppercase tracking-wide">Bring your squad</h3>
        <p class="mt-3 text-sm leading-relaxed text-facility-300">
          Rounds are better with people you know, and better still when one of them is the Hunter.
          Send them the link.
        </p>
        <p class="mt-5">
          <button type="button" id="shareStatic" class="btn-primary" data-url={shareUrl}>
            Share STATIC <span aria-hidden="true">→</span>
          </button>
        </p>
        <p class="mt-3 font-mono text-[0.62rem] tracking-[0.18em] text-signal" id="shareStatus" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const btn = document.getElementById('shareStatic');
    const status = document.getElementById('shareStatus');
    if (!btn) return;

    const setStatus = function (msg: string) {
      if (status) status.textContent = msg;
    };

    btn.addEventListener('click', function () {
      const url = btn.getAttribute('data-url') || window.location.origin + '/';
      const data = {
        title: 'STATIC — free Roblox horror game',
        text: 'Free co-op horror on Roblox: haul scrap to the crushers while a jester called Jingles hunts you. Play with me?',
        url: url,
      } as const;

      // Native share sheet (mobile, some desktops) — else clipboard fallback.
      const nav = navigator as Navigator & { share?: (d: ShareData) => Promise<void> };
      if (nav.share) {
        nav.share(data).then(
          function () { setStatus('SENT — SEE YOU IN THE BUNKER'); },
          function () { /* user canceled — stay quiet */ }
        );
        return;
      }

      navigator.clipboard.writeText(url).then(
        function () { setStatus('LINK COPIED'); },
        function () { setStatus('COPY FAILED — SHARE ' + url); }
      );
    });
  })();
</script>
