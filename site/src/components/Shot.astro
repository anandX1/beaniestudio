---
/**
 * A game screenshot from the registry: responsive AVIF with a WebP fallback,
 * intrinsic width/height (zero CLS), lazy by default. `lightbox` wraps it in
 * a link to the full-size file that Lightbox.astro opens in a <dialog>;
 * without JS the link simply opens the image.
 *
 * LAYOUT NOTE — why <picture> carries `display: contents`
 *   As a bare <img>, this element's containing block was the `.shot-frame`,
 *   the `.shot-link` or `.hero-cine-bg` that surrounds it, which is what makes
 *   the existing `height: 100%` / `width: 100%` / intrinsic-ratio rules
 *   resolve. A <picture> with its default `display: inline` would sit between
 *   them and could change that resolution. `display: contents` removes the
 *   <picture> box from the box tree entirely, so the <img>'s containing block
 *   is byte-for-byte the same element it was before. CLS is unchanged.
 *
 * FORMAT NOTE — why there is only one <source>
 *   The <img> keeps the WebP srcset it already had, so it *is* the WebP
 *   fallback; a second `<source type="image/webp">` would repeat the same
 *   srcset for no behavioural gain. The AVIF <source> comes first and is
 *   guarded by `type="image/avif"`: a browser that cannot decode AVIF skips it
 *   *without issuing a request* and falls through to the <img>. That guard —
 *   not the element order — is what stops a double download.
 *
 *   The AVIF srcset is derived from the WebP srcset by extension because
 *   scripts/media-avif.mjs mirrors scripts/media.mjs bucket for bucket (same
 *   widths, same names, never upscaled). `node scripts/media-avif.mjs --check`
 *   asserts that mirror still holds after a shot is added.
 *
 *   `Shot.full` deliberately stays WebP — see src/data/media.ts.
 *
 * PRIORITY NOTE — why a non-eager image declares `fetchpriority="low"`
 *   `loading="lazy"` already keeps these images out of the initial load, but on
 *   a long homepage the browser still discovers ~35 of them while the hero is
 *   decoding. `fetchpriority="low"` demotes them below the hero image, the
 *   fonts and the CSS in the fetch scheduler, which is exactly the ordering this
 *   page wants: the LCP element is `central-room-globe` and nothing else should
 *   compete with it. The attribute is ignored by browsers that do not implement
 *   it, and for lazy images it can never raise priority — so it is a one-way
 *   demotion with no failure mode. The hero passes `eager` and keeps `high`.
 */
import { shot } from '../data/media';
import Icon from './Icon.astro';

interface Props {
  id: string;
  sizes?: string;
  class?: string;
  imgClass?: string;
  eager?: boolean;
  /** Gallery name for prev/next in the lightbox. Omit for a plain image. */
  lightbox?: string;
  caption?: string;
  /** Override the registry alt text (rare — prefer editing media.json). */
  alt?: string;
  /** Inline style for the <img> (e.g. object-position for a crop). */
  imgStyle?: string;
}

const { id, sizes = '(min-width: 1280px) 1200px, 100vw', class: cls, imgClass, eager = false, lightbox, caption, alt, imgStyle } = Astro.props;
const s = shot(id);
/** Same widths and descriptors as s.srcset, AVIF instead of WebP. */
const avifSrcset = s.srcset.replace(/\.webp/g, '.avif');
const img = {
  src: s.w > 1280 ? `/media/${s.id}-1280.webp` : s.full,
  srcset: s.srcset,
  sizes,
  width: s.w,
  height: s.h,
  alt: alt ?? s.alt,
  loading: eager ? ('eager' as const) : ('lazy' as const),
  decoding: 'async' as const,
  fetchpriority: eager ? ('high' as const) : ('low' as const),
  class: imgClass,
  style: imgStyle,
};
---

{lightbox ? (
  <a href={s.full} class:list={['shot-link', cls]} data-lb={lightbox} data-caption={caption ?? s.alt}>
    <picture style="display: contents">
      <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
      <img {...img} />
    </picture>
    <span class="shot-zoom" aria-hidden="true"><Icon name="expand" inline /></span>
  </a>
) : (
  <picture style="display: contents">
    <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
    <img {...img} class:list={[cls, imgClass]} />
  </picture>
)}
