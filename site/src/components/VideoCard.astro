---
/**
 * Lite YouTube embed card — a self-hosted thumbnail that swaps to a
 * youtube-nocookie iframe only on click. Zero framework JS, no third-party
 * requests until the visitor actually wants to play.
 */
import { type SiteVideo, watchUrl, embedUrl, thumbUrl } from '../data/videos';

interface Props {
  video: SiteVideo;
  /** Set on the above-the-fold card so it isn't lazy-loaded. */
  eager?: boolean;
}

const { video, eager = false } = Astro.props;
---

<figure class="video-card panel" data-video-card>
  <div class="relative aspect-video overflow-hidden bg-facility-900">
    <!-- Thumbnail + play affordance (progressively enhanced into an embed) -->
    <button
      type="button"
      data-video-trigger
      data-embed={embedUrl(video.id)}
      data-title={video.title}
      class="group absolute inset-0 h-full w-full cursor-pointer"
      aria-label={`Play video: ${video.title} (opens YouTube embed)`}
    >
      <img
        src={thumbUrl(video.id)}
        alt={`Video thumbnail: ${video.title}`}
        width="1280"
        height="720"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover opacity-90 transition duration-300 group-hover:scale-[1.03] group-hover:opacity-100"
      />
      <span
        class="absolute inset-0 grid place-items-center bg-facility-950/25 transition group-hover:bg-facility-950/10"
        aria-hidden="true"
      >
        <span
          class="grid h-14 w-14 place-items-center border-2 border-signal bg-facility-950/70 font-mono text-xl text-signal transition group-hover:bg-signal group-hover:text-facility-950"
        >
          ▶
        </span>
      </span>
      <span class="kicker absolute bottom-2 left-3 !text-[0.6rem] bg-facility-950/70 px-2 py-1">
        {video.tag}
      </span>
    </button>

    <!-- No-JS fallback: thumbnail links straight to YouTube -->
    <noscript>
      <a
        href={watchUrl(video.id)}
        target="_blank"
        rel="noopener"
        class="absolute inset-0 grid place-items-center bg-facility-950/60 font-mono text-xs uppercase tracking-[0.2em] text-signal"
      >
        Watch on YouTube ↗
      </a>
    </noscript>
  </div>

  <figcaption class="p-5">
    <h3 class="font-display text-base font-bold uppercase tracking-wide text-facility-100">
      {video.title}
    </h3>
    <p class="mt-1.5 text-sm leading-relaxed text-facility-300">{video.note}</p>
    <a
      href={watchUrl(video.id)}
      target="_blank"
      rel="noopener"
      class="mt-3 inline-block font-mono text-xs tracking-[0.18em] text-signal-dim transition-colors hover:text-signal"
    >
      OPEN ON YOUTUBE ↗
    </a>
  </figcaption>
</figure>

<script>
  // Facade swap: one click replaces the thumbnail with the privacy-mode
  // iframe. The listener is attached per-card so nothing global leaks.
  document.querySelectorAll<HTMLElement>('[data-video-card]').forEach((card) => {
    const trigger = card.querySelector<HTMLElement>('[data-video-trigger]');
    if (!trigger) return;
    trigger.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = trigger.dataset.embed || '';
      frame.title = trigger.dataset.title || 'STATIC video player';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      frame.frameBorder = '0';
      frame.className = 'absolute inset-0 h-full w-full';
      const host = trigger.parentElement;
      if (host) host.replaceChildren(frame);
    });
  });
</script>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
  }
</style>
