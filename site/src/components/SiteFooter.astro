---
import { SITE, CHANNELS } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="border-t border-facility-700 bg-facility-950">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-[1.2fr_2fr]">
      <div>
        <p class="kicker">Comm Channels</p>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-facility-300">
          {SITE.name} is a small team building STATIC: Salvage vs Hunter for Roblox. Wishlists and
          follows decide whether the doors open on schedule — every channel below is a way to be
          there when they do.
        </p>
        <a href={`mailto:${SITE.contact}`} class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-facility-100 hover:text-signal">
          {SITE.contact}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2">
        <li>
          <a href="/creators" class="group block">
            <span class="flex items-center justify-between border-b border-facility-700 pb-2 font-display text-sm font-bold uppercase tracking-wider text-facility-100 transition-colors group-hover:text-signal">
              Creator program
              <span class="text-signal transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </span>
            <span class="mt-1.5 block font-mono text-xs text-facility-500">Stream STATIC? Get the creator kit</span>
          </a>
        </li>
        {CHANNELS.map((ch) => (
          <li>
            <a href={ch.url} rel="noopener" target={ch.url.startsWith('http') ? '_blank' : undefined} class="group block">
              <span class="flex items-center justify-between border-b border-facility-700 pb-2 font-display text-sm font-bold uppercase tracking-wider text-facility-100 transition-colors group-hover:text-signal">
                {ch.name}
                <span class="text-signal transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
              <span class="mt-1.5 block font-mono text-xs text-facility-500">{ch.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-facility-800 pt-6 font-mono text-xs text-facility-500 sm:flex-row sm:items-center sm:justify-between">
      <span>© {year} {SITE.name}. STATIC and the Beanie Studio name are works of fiction in progress.</span>
      <span class="flex items-center gap-2">
        <span class="dot" aria-hidden="true"></span>
        TRANSMISSION ACTIVE
      </span>
    </div>
  </div>
</footer>
