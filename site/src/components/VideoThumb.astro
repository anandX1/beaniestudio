---
/**
 * Video thumbnail that LINKS to its /videos/<slug>/ watch page.
 *
 * Deliberately not a facade (see VideoCard.astro): a listing page's job here is
 * to send visitors — and crawlers — to the one page per video where the embed
 * lives in the HTML and the video is the main content. Uses the same self-hosted
 * /yt/<id>.jpg thumbnails, so still zero YouTube requests before a click.
 */
import { type SiteVideo, thumbUrl, thumbDims } from '../data/videos';

interface Props {
  video: SiteVideo;
  /** Set on above-the-fold thumbnails so they aren't lazy-loaded. */
  eager?: boolean;
}

const { video, eager = false } = Astro.props;
const dims = thumbDims(video.id);

const fmtDate = new Date(`${video.date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<a href={`/videos/${video.slug}/`} class="video-thumb panel group flex flex-col" data-video-thumb>
  <div class="relative aspect-video overflow-hidden border-b border-facility-700 bg-facility-900">
    <img
      src={thumbUrl(video.id)}
      alt={`Video thumbnail: ${video.title}`}
      width={dims.w}
      height={dims.h}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="h-full w-full object-cover opacity-90 transition duration-300 group-hover:scale-[1.03] group-hover:opacity-100"
    />
    <span
      class="absolute inset-0 grid place-items-center transition group-hover:bg-facility-950/10"
      aria-hidden="true"
    >
      <span
        class="grid h-12 w-12 place-items-center border-2 border-signal bg-facility-950/70 font-mono text-lg text-signal transition group-hover:bg-signal group-hover:text-facility-950"
      >
        ▶
      </span>
    </span>
    <span class="kicker absolute bottom-2 left-3 !text-[0.6rem] bg-facility-950/70 px-2 py-1">
      {video.tag}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-display text-base font-bold uppercase tracking-wide text-facility-100 group-hover:text-signal">
      {video.title}
    </h3>
    <p class="mt-1.5 text-sm leading-relaxed text-facility-300">{video.note}</p>
    <p class="mt-auto pt-4 font-mono text-xs tracking-[0.14em] text-facility-500">
      <time datetime={video.date}>{fmtDate.toUpperCase()}</time>
    </p>
  </div>
</a>

<style>
  .video-thumb {
    transition: border-color 0.18s var(--ease-terminal);
  }
  .video-thumb:hover {
    border-color: var(--color-signal-dim);
  }
</style>
