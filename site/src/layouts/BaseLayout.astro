---
import '../styles/global.css';
// Fonts are self-hosted from /public/fonts with STABLE filenames (see
// scripts/copy-fonts.mjs): preloaded in <head>, so the browser starts the
// fetch with the HTML instead of after CSS+@font-face parsing (Lighthouse
// measured the old hashed-font chain at 1,310ms on the critical path).
import '../styles/fonts.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, LINKS } from '../site.config';
import { TEAM } from '../data/game';

interface Props {
  /** Page title — rendered as "%page% — Beanie Studio" (or verbatim if it already contains the brand). */
  title: string;
  description?: string;
  /** Path with leading slash, e.g. '/play'. Used for canonical + og:url (trailing slash normalized). */
  path: string;
  /** Absolute path to the 1200×630 OG card (defaults to /og/home.jpg). */
  ogImage?: string;
  /**
   * Real pixel dimensions of `ogImage`. Only the generated `/og/*.png` cards are
   * 1200×630; pages that point og:image at a raw screenshot (guide/map,
   * /screenshots) MUST pass that shot's true width/height. Crawlers lay the card
   * out from these numbers before the image finishes downloading, so a wrong
   * ratio renders a cropped or letterboxed preview.
   */
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Alt text describing the OG card for screen readers and crawlers. */
  ogImageAlt?: string;
  /** Extra JSON-LD blocks rendered on this page. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail → emits BreadcrumbList structured data. */
  breadcrumb?: { name: string; path: string }[];
  /** Set true on utility pages (404) that must stay out of indexes. */
  noindex?: boolean;
  /** Open Graph type — 'article' for devlog posts. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  path,
  ogImage = '/og/home.jpg',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = 'STATIC — free Roblox horror game by Beanie Studios',
  jsonLd = [],
  breadcrumb,
  noindex = false,
  ogType = 'website',
} = Astro.props;

/** Cloudflare Web Analytics token — injected only when the environment provides it, so nothing loads until the user opts in by setting the token in DEPLOY.md. */
const analyticsToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN || '';

/** Beacon loader: waits for window load + the first idle window, then injects
 *  the beacon. Analytics is not load-bearing; its startup work (measured
 *  325–500ms of main-thread on a throttled phone) must not compete with
 *  first paint. Same behavior, quieter window. */
const beaconLoader = `(function () {
  var fire = function () {
    var s = document.createElement("script");
    s.defer = true;
    s.src = "https://static.cloudflareinsights.com/beacon.min.js";
    s.setAttribute("data-cf-beacon", '${JSON.stringify({ token: analyticsToken }).replace(/'/g, '&#39;')}');
    document.head.appendChild(s);
  };
  var go = function () {
    if ("requestIdleCallback" in window) requestIdleCallback(fire, { timeout: 3000 });
    else setTimeout(fire, 1200);
  };
  if (document.readyState === "complete") go();
  else window.addEventListener("load", go, { once: true });
})();`;

/** Canonical URLs use the trailing-slash directory form Astro actually serves. */
const normPath = path === '/' ? '/' : path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(normPath, SITE.url);
const ogImageAbs = new URL(ogImage, SITE.url);
// Title budget: SERP snippets truncate ~60 chars. Append the brand only when the
// total stays within budget; when the page title alone fills it, let the page
// title stand alone (better a complete page title than a truncated brand tail).
const brandSuffix = ' | Beanie Studios';
const fullTitle =
  // Count "&" as its HTML-escaped length (&amp;) — that's what crawlers and the live audit measure.
  title.includes('Beanie Studio') || title.replace(/&/g, '&amp;').length + brandSuffix.length > 60
    ? title
    : `${title}${brandSuffix}`;

/** Site-wide Organization graph, present on every page. */
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: SITE.name,
  alternateName: 'Beanie Studio',
  url: SITE.url,
  email: SITE.contact,
  logo: new URL('/logo.png', SITE.url).href,
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer support', email: SITE.contact, availableLanguage: 'en' },
    { '@type': 'ContactPoint', contactType: 'press', email: SITE.press, availableLanguage: 'en' },
  ],
  founder: TEAM.map((t) => ({ '@type': 'Person', name: t.name, jobTitle: t.title, email: t.email })),
  foundingDate: '2026-07',
  sameAs: [
    LINKS.roblox,
    LINKS.discord,
    LINKS.youtube,
    LINKS.instagram,
    LINKS.x,
    // Wikidata entity — the knowledge-graph anchor AI engines resolve
    LINKS.wikidataStudio,
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: 'STATIC by Beanie Studios',
  url: SITE.url,
  publisher: { '@id': `${SITE.url}/#org` },
};

/** BreadcrumbList — wins sitelink breadcrumbs in SERPs. */
const breadcrumbLd = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.path.endsWith('/') || crumb.path === '/' ? crumb.path : `${crumb.path}/`, SITE.url).href,
      })),
    }
  : null;

const allLd = [organizationLd, websiteLd, breadcrumbLd, ...jsonLd].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Preload the 3 fonts above the fold actually uses (mono + display weights).
         Stable /fonts/ names + preload = font fetch starts with the HTML,
         no CSS→@font-face discovery chain (was 1,310ms on mobile). -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono-latin-wght-normal.v2.woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/chakra-petch-latin-700-normal.v2.woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/chakra-petch-latin-500-normal.v2.woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/public-sans-latin-wght-normal.v2.woff2" crossorigin="anonymous" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    <!-- Google Search Console ownership verification (URL-prefix method).
         Domain properties verify via the DNS TXT record instead — both stay
         in place permanently so ownership survives either path. -->
    <meta name="google-site-verification" content="p-POBX1mKG1k2DYgeWx4mZly8rQtR_6dUYUWgWOVjyg" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#16181d" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@BeanieStudiosHQ" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(allLd)} />

    <slot name="head" />

    <!-- Scroll-motion fallback for browsers without CSS scroll timelines.
         MUST run in <head>, before body paints: `.fx-io` is what arms the
         hidden starting states, so adding it later would flash the content
         in and then hide it. Browsers that DO support animation-timeline
         bail out on the first check and download/execute nothing further. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (!('IntersectionObserver' in window)) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // Feature-detect rather than sniff: if scroll timelines work, the CSS
        // originals are already better (compositor thread, zero main-thread cost).
        if (window.CSS && CSS.supports && CSS.supports('animation-timeline: view()')) return;

        d.classList.add('fx-io');

        var io = null;
        function arm() {
          var els = document.querySelectorAll('.rise, .reveal, .draw-path, .gauge-fill, .count');
          if (!els.length) return;
          io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              var e = entries[i];
              if (!e.isIntersecting) continue;
              io.unobserve(e.target);
              e.target.classList.add('in');
              var real = e.target.querySelector('.count-real');
              if (real) countUp(real);
            }
          }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
          for (var j = 0; j < els.length; j++) io.observe(els[j]);
        }

        /** Count a stat from 0 to its real value. The real string is already in
         *  the DOM, so no-JS readers see the number itself. */
        function countUp(el) {
          var final = el.textContent || '';
          var to = parseInt(final.replace(/[^0-9]/g, ''), 10);
          if (!isFinite(to) || to <= 0) return;
          var start = null;
          var DUR = 1200;
          function step(ts) {
            if (start === null) start = ts;
            var p = Math.min(1, (ts - start) / DUR);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(to * eased));
            if (p < 1) requestAnimationFrame(step);
            else el.textContent = final;
          }
          el.textContent = '0';
          requestAnimationFrame(step);
        }

        /** Scroll-linked transforms. Progress is the same 0→1 the equivalent
         *  `view()` timeline would report over its cover range. */
        function armScroll() {
          var hero = document.querySelector('.hero-cine');
          var par = [].slice.call(document.querySelectorAll('.parallax'));
          var kin = [].slice.call(document.querySelectorAll('.kinetic'));
          if (!hero && !par.length && !kin.length) return;

          var ticking = false;
          function viewProgress(el) {
            var r = el.getBoundingClientRect();
            var vh = window.innerHeight || d.clientHeight;
            var total = r.height + vh;
            if (total <= 0) return 0;
            var p = (vh - r.top) / total;
            return p < 0 ? 0 : p > 1 ? 1 : p;
          }
          function update() {
            ticking = false;
            if (hero) {
              var vh = window.innerHeight || d.clientHeight;
              var hp = vh > 0 ? (window.pageYOffset || d.scrollTop || 0) / vh : 0;
              d.style.setProperty('--fx-hero', String(hp < 0 ? 0 : hp > 1 ? 1 : hp));
            }
            for (var i = 0; i < par.length; i++) par[i].style.setProperty('--fx-par', String(viewProgress(par[i])));
            for (var k = 0; k < kin.length; k++) kin[k].style.setProperty('--fx-kin', String(viewProgress(kin[k])));
          }
          function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
          update();
        }

        /** Reveal every armed element that has reached the viewport.
         *  Reads are batched ahead of writes on purpose: interleaving
         *  getBoundingClientRect with classList.add dirties style on every
         *  iteration and forces a full recalculation per element. */
        function sweep() {
          var stuck = document.querySelectorAll('.rise:not(.in), .reveal:not(.in)');
          if (!stuck.length) return;
          var limit = (window.innerHeight || d.clientHeight) * 1.2;
          var reveal = [];
          for (var i = 0; i < stuck.length; i++) {
            if (stuck[i].getBoundingClientRect().top < limit) reveal.push(stuck[i]);
          }
          for (var j = 0; j < reveal.length; j++) reveal[j].classList.add('in');
        }

        function boot() {
          arm();
          armScroll();
          // Safety net: an IntersectionObserver is sampled once per frame, so a hard
          // flick can carry an element past the viewport without it ever being
          // reported as intersecting, leaving it stranded at opacity 0. A trailing
          // sweep after the scroll settles makes that impossible.
          var sweepTimer = 0;
          window.addEventListener('scroll', function () {
            if (sweepTimer) clearTimeout(sweepTimer);
            sweepTimer = setTimeout(sweep, 120);
          }, { passive: true });
          window.setTimeout(sweep, 2500);
          window.setTimeout(sweep, 4000);
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
        else boot();
      })();
    </script>

    <!-- Cloudflare Web Analytics — cookie-free, GDPR-friendly. The beacon's
         startup burns 300–500ms of main-thread time on a throttled phone, so
         it loads after the page goes idle instead of competing with paint.
         Loads only when PUBLIC_CF_BEACON_TOKEN is set at build time. -->
    {analyticsToken && (
      <script is:inline set:html={beaconLoader} />
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] focus:bg-signal focus:text-facility-950 focus:px-3 focus:py-2 focus:font-mono"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <!-- Decode scramble: any element with data-decode resolves through terminal
         glyphs on first viewport entry. The real string is saved to the attribute
         before any overwrite, so no-JS / reduced-motion visitors see plain text.
         Runs on a timer, not rAF, so it animates even when frames are throttled. -->
    <script>
      (function () {
        const els = document.querySelectorAll('[data-decode]');
        if (!els.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        const GLYPHS = '#$%&@/\\<>*+=?!01';
        const decodeOne = function (el: HTMLElement) {
          const final = el.getAttribute('data-decode') || '';
          let frame = 0;
          const total = Math.max(14, Math.min(34, final.length * 2));
          // Scrambled glyphs have different widths than the real string, so
          // unlocked text re-wraps line-by-line and drags the whole page
          // (measured 0.179 CLS on a long devlog headline). Lock the box to
          // its real-text height for the duration; border-box sizing makes
          // offsetHeight directly assignable. Brief clipping of noise glyphs
          // is invisible — it's noise.
          const locked = el.offsetHeight;
          el.style.height = locked + 'px';
          el.style.overflow = 'hidden';
          const id = window.setInterval(function () {
            frame++;
            const settled = Math.floor((frame / total) * final.length);
            let out = '';
            for (let i = 0; i < final.length; i++) {
              out += i < settled || final[i] === ' ' ? final[i] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
            }
            el.textContent = out;
            if (frame >= total) {
              window.clearInterval(id);
              el.textContent = final;
              el.style.height = '';
              el.style.overflow = '';
            }
          }, 42);
        };

        const io = new IntersectionObserver(function (entries) {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.unobserve(e.target);
            decodeOne(e.target as HTMLElement);
          }
        }, { threshold: 0.5 });
        els.forEach((el) => {
          if (!el.getAttribute('data-decode')) {
            el.setAttribute('data-decode', (el.textContent || '').trim());
          }
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
