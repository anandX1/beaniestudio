---
import '../styles/global.css';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource-variable/public-sans';
import '@fontsource-variable/jetbrains-mono';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, LINKS } from '../site.config';

interface Props {
  /** Page title — rendered as "%page% — Beanie Studio" (or verbatim if it already contains the brand). */
  title: string;
  description?: string;
  /** Path with leading slash, e.g. '/play'. Used for canonical + og:url (trailing slash normalized). */
  path: string;
  /** Absolute path to the 1200×630 OG card (defaults to /og/home.png). */
  ogImage?: string;
  /** Alt text describing the OG card for screen readers and crawlers. */
  ogImageAlt?: string;
  /** Extra JSON-LD blocks rendered on this page. */
  jsonLd?: Record<string, unknown>[];
  /** Breadcrumb trail → emits BreadcrumbList structured data. */
  breadcrumb?: { name: string; path: string }[];
  /** Set true on utility pages (404) that must stay out of indexes. */
  noindex?: boolean;
  /** Open Graph type — 'article' for devlog posts. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  path,
  ogImage = '/og/home.png',
  ogImageAlt = `${SITE.name} — key art card`,
  jsonLd = [],
  breadcrumb,
  noindex = false,
  ogType = 'website',
} = Astro.props;

/** Cloudflare Web Analytics token — injected only when the environment provides it, so nothing loads until the user opts in by setting the token in DEPLOY.md. */
const analyticsToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN || '';

/** Canonical URLs use the trailing-slash directory form Astro actually serves. */
const normPath = path === '/' ? '/' : path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(normPath, SITE.url);
const ogImageAbs = new URL(ogImage, SITE.url);
const fullTitle = title.includes('Beanie Studio') ? title : `${title} — Beanie Studio`;

/** Site-wide Organization graph, present on every page. */
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.contact,
  logo: new URL('/logo.png', SITE.url).href,
  sameAs: [LINKS.roblox, LINKS.discord, LINKS.youtube, LINKS.instagram, LINKS.x],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
};

/** BreadcrumbList — wins sitelink breadcrumbs in SERPs. */
const breadcrumbLd = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.path.endsWith('/') || crumb.path === '/' ? crumb.path : `${crumb.path}/`, SITE.url).href,
      })),
    }
  : null;

const allLd = [organizationLd, websiteLd, breadcrumbLd, ...jsonLd].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />

    <!-- Google Search Console ownership verification (URL-prefix method).
         Domain properties verify via the DNS TXT record instead — both stay
         in place permanently so ownership survives either path. -->
    <meta name="google-site-verification" content="p-POBX1mKG1k2DYgeWx4mZly8rQtR_6dUYUWgWOVjyg" />

    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#16181d" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@BeanieStudiosHQ" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(allLd)} />

    <!-- Cloudflare Web Analytics — cookie-free, GDPR-friendly, zero CWV cost.
         Loads only when PUBLIC_CF_BEACON_TOKEN is set at build time. -->
    {analyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "${analyticsToken}"}'></script>
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] focus:bg-signal focus:text-facility-950 focus:px-3 focus:py-2 focus:font-mono"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <!-- Decode scramble: any element with data-decode resolves through terminal
         glyphs on first viewport entry. The real string is saved to the attribute
         before any overwrite, so no-JS / reduced-motion visitors see plain text.
         Runs on a timer, not rAF, so it animates even when frames are throttled. -->
    <script>
      (function () {
        const els = document.querySelectorAll('[data-decode]');
        if (!els.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        const GLYPHS = '#$%&@/\\<>*+=?!01';
        const decodeOne = function (el: Element) {
          const final = el.getAttribute('data-decode') || '';
          let frame = 0;
          const total = Math.max(14, Math.min(34, final.length * 2));
          const id = window.setInterval(function () {
            frame++;
            const settled = Math.floor((frame / total) * final.length);
            let out = '';
            for (let i = 0; i < final.length; i++) {
              out += i < settled || final[i] === ' ' ? final[i] : GLYPHS[(Math.random() * GLYPHS.length) | 0];
            }
            el.textContent = out;
            if (frame >= total) { window.clearInterval(id); el.textContent = final; }
          }, 42);
        };

        const io = new IntersectionObserver(function (entries) {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            io.unobserve(e.target);
            decodeOne(e.target);
          }
        }, { threshold: 0.5 });
        els.forEach((el) => {
          if (!el.getAttribute('data-decode')) {
            el.setAttribute('data-decode', (el.textContent || '').trim());
          }
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
