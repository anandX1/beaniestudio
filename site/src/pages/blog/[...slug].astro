---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('devlog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

/** Share targets — canonical URL + UTM so analytics attributes every share. */
const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const shareUrl = `${postUrl}?utm_source=shared&utm_medium=social&utm_campaign=blog`;
const xIntent = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`${post.data.title} — STATIC devlog`)}&url=${encodeURIComponent(shareUrl)}`;

const fmtDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: [new URL('/og/blog.png', Astro.site).href],
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  articleSection: post.data.tag,
  keywords: `STATIC, roblox horror game, roblox blog, ${post.data.tag ?? 'game development'}, Beanie Studio`,
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'Beanie Studio', url: Astro.site?.href },
  publisher: {
    '@type': 'Organization',
    name: 'Beanie Studio',
    logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href },
  },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, Astro.site).href,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  ogImage="/og/blog.png"
  ogType="article"
  jsonLd={[postLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: post.data.title, path: `/blog/${post.id}` }]}
>
  <article class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="kicker">Blog — {post.data.tag}</p>
    <h1 class="mt-6 font-display text-3xl font-bold uppercase leading-tight tracking-tight sm:text-5xl" data-decode>
      {post.data.title}
    </h1>
    <time datetime={post.data.pubDate.toISOString()} class="mt-4 block font-mono text-xs text-facility-500">
      {fmtDate}
    </time>

    <div
      class="prose-static mt-12"
      set:html={''}
    >
      <Content />
    </div>

    <div class="mt-16 border-t border-facility-700 pt-8">
      <!-- Transmit strip: native share sheet on phones, X intent + clipboard
           fallback on desktop. No third-party buttons/scripts — just links. -->
      <div class="mb-8 flex flex-wrap items-center gap-4">
        <span class="font-mono text-xs tracking-[0.2em] text-facility-500">TRANSMIT THIS ENTRY</span>
        <button
          type="button"
          id="sharePost"
          class="btn-secondary px-4 py-1.5 font-mono text-xs uppercase tracking-widest"
          data-url={shareUrl}
          data-title={post.data.title}
        >Share <span aria-hidden="true">→</span></button>
        <a
          href={xIntent}
          target="_blank"
          rel="noopener"
          class="font-mono text-xs uppercase tracking-widest text-signal hover:text-signal-dim"
        >Post on X <span aria-hidden="true">↗</span></a>
        <span id="shareCopied" class="font-mono text-xs text-signal" role="status" aria-live="polite"></span>
      </div>
      <a href="/blog/" class="font-mono text-sm text-signal hover:text-signal-dim">← All posts</a>
    </div>
  </article>

  <!-- Hunter proximity bar: article reading progress reframed as dread —
       the deeper you read, the closer IT gets. Fixed to the bottom edge:
       rises from below, never collides with the sticky header. -->
  <div class="fixed inset-x-0 bottom-0 z-[60]">
    <div class="hunter-bar" id="huntBar">
      <div class="hunter-bar-fill"></div>
    </div>
    <div class="flex items-center justify-between bg-facility-950/90 px-4 py-1.5 backdrop-blur sm:px-6">
      <span class="font-mono text-[0.58rem] tracking-[0.22em] text-facility-500" id="huntTag">HUNTER DISTANCE: FAR</span>
      <span class="font-mono text-[0.58rem] tracking-[0.22em] text-status-red" id="huntPct" role="meter" aria-label="Hunter proximity" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">0%</span>
    </div>
  </div>

  <script>
    (function () {
      const bar = document.getElementById('huntBar');
      const tag = document.getElementById('huntTag');
      const pct = document.getElementById('huntPct');
      if (!bar || !tag || !pct) return;

      const DISTANCES = [
        { at: 75, label: 'IN THE CORRIDOR' },
        { at: 45, label: 'CLOSING IN' },
        { at: 15, label: 'MOVING' },
        { at: -1, label: 'FAR' },
      ];
      let ticking = false;
      const update = function () {
        ticking = false;
        const article = document.querySelector('article');
        if (!article) return;
        const r = article.getBoundingClientRect();
        const total = r.height - window.innerHeight;
        const done = Math.min(1, Math.max(0, -r.top / (total > 0 ? total : 1)));
        const p = done * 100;
        bar.style.setProperty('--hunt', p.toFixed(1) + '%');
        pct.setAttribute('aria-valuenow', String(Math.round(p)));
        pct.textContent = Math.round(p) + '%';
        const d = DISTANCES.find((x) => p >= x.at) || DISTANCES[3];
        const label = 'HUNTER DISTANCE: ' + d.label;
        if (tag.textContent !== label) tag.textContent = label;
      };
      const onScroll = function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      update();
    })();
  </script>

  <!-- Share button: native share sheet where it exists, clipboard fallback. -->
  <script>
    (function () {
      const btn = document.getElementById('sharePost');
      const out = document.getElementById('shareCopied');
      if (!btn) return;
      btn.addEventListener('click', function () {
        const url = btn.getAttribute('data-url') || window.location.href;
        const title = btn.getAttribute('data-title') || 'STATIC devlog';
        const nav = navigator as Navigator & { share?: (d: ShareData) => Promise<void> };
        if (nav.share) {
          nav.share({ title: title, text: 'STATIC: Salvage vs Hunter — devlog', url: url }).catch(function () {});
          return;
        }
        navigator.clipboard.writeText(url).then(
          function () { if (out) out.textContent = 'LINK COPIED'; },
          function () { if (out) out.textContent = url; }
        );
      });
    })();
  </script>
  </article>
</BaseLayout>

<style>
  /* Hand-rolled prose styling — typeset to the design system, no plugin. */
  .prose-static :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2.5rem;
    margin-bottom: 0.9rem;
  }
  .prose-static :global(h3) {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2rem;
    margin-bottom: 0.7rem;
  }
  .prose-static :global(p) {
    margin-bottom: 1.1rem;
    line-height: 1.75;
    color: var(--color-facility-300);
  }
  .prose-static :global(ul) {
    margin: 0 0 1.1rem 1.25rem;
    list-style: square;
    color: var(--color-facility-300);
  }
  .prose-static :global(ol) {
    margin: 0 0 1.1rem 1.25rem;
    list-style: decimal;
    color: var(--color-facility-300);
  }
  .prose-static :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.65;
  }
  .prose-static :global(strong) {
    color: var(--color-facility-100);
  }
  .prose-static :global(a) {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-static :global(blockquote) {
    border-left: 2px solid var(--color-signal-dim);
    padding: 0.4rem 0 0.4rem 1.1rem;
    margin: 1.4rem 0;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--color-facility-100);
  }
  .prose-static :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--color-facility-800);
    padding: 0.15em 0.4em;
  }
  .prose-static :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-facility-700);
    margin: 2.2rem 0;
  }
</style>
