---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import FollowSection from '../components/FollowSection.astro';
import Shot from '../components/Shot.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import { SITE, LINKS } from '../site.config';
import { FEATURED_VIDEO, VIDEOS, watchUrl } from '../data/videos';
import { shot, SHOTS } from '../data/media';
import { ROOM_INFO } from '../data/rooms';
import {
  GAME, MOVEMENT, JINGLES, POD, SCRAP, CRUSHERS, MINIGAMES, EXTRACTION, WORM, ROADMAP, TEAM, COMMUNITY, SCRAPPER, RESULTS, PROGRESSION,
} from '../data/game';

const lightest = SCRAP[0];
const heaviest = SCRAP[SCRAP.length - 1];
const heroShot = shot('central-room-globe');

const tickerItems = [
  `CRUSHER QUOTA: ${CRUSHERS.totalKg} KG`,
  `HUNTER BLOODLUST: EVERY ${JINGLES.bloodlust.everySec} SECONDS`,
  `POD TIMER: ${POD.timerSec} SECONDS`,
  `EXTRACTION WINDOW: ${EXTRACTION.windowSec} SECONDS`,
  'DO NOT RING THE BELL',
  'THE WORM HATES LIGHT',
];

const loop = [
  {
    n: '01', t: 'Scavenge', icon: 'scrap' as const, shot: 'storage-bay', pos: '50% 50%',
    b: `${SCRAP.length} kinds of scrap, ${lightest.kg} kg to ${heaviest.kg} kg. Two backpack slots. Heavy stuff goes in your hands.`,
    link: { href: '/guide/scrap/', label: 'Every scrap item' },
  },
  {
    n: '02', t: 'Crush', icon: 'crusher' as const, shot: 'crusher-console', pos: '18% 50%',
    b: `${CRUSHERS.count} crushers, random spots, ${CRUSHERS.totalKg} kg to feed. Crushing is loud.`,
    link: { href: '/guide/crushers/', label: 'How crushers work' },
  },
  {
    n: '03', t: 'Calibrate', icon: 'console' as const, shot: 'crusher-console', pos: '82% 50%',
    b: `${CRUSHERS.minigamesPerConsole} minigames per console, from a pool of ${MINIGAMES.length}. Fail one and it faults.`,
    link: { href: '/guide/crushers/#minigames', label: `All ${MINIGAMES.length} minigames` },
  },
  {
    n: '04', t: 'Escape', icon: 'exit' as const, shot: 'result-escaped', pos: '50% 30%',
    b: `The ${EXTRACTION.room} opens for ${EXTRACTION.windowSec} seconds. Make it and a UFO beams you out.`,
    link: { href: '/guide/', label: 'Beginner guide' },
  },
];

const stats = [
  { to: CRUSHERS.totalKg, unit: 'KG', label: 'of scrap to crush', icon: 'weight' as const, gauge: true },
  { to: MINIGAMES.length, unit: '', label: 'console minigames', icon: 'console' as const },
  { to: POD.timerSec, unit: 'SEC', label: 'to save a captured friend', icon: 'pod' as const },
  { to: GAME.serverSize, unit: '', label: 'players per server', icon: 'users' as const },
];

const ribbonA = ['cargo-dock-shuttle', 'reactor-coils', 'medbay', 'control-room-hologram', 'storage-bay', 'jingles-red', 'central-room-globe', 'interrogation', 'cargo-dock-floor', 'security'];
const ribbonB = ['jingles-medbay', 'reactor-tanks', 'storage-bay-forklift', 'control-room', 'worm-render', 'pod-active', 'medbay-red', 'hunter-reveal', 'cargo-dock-bay', 'reactor-door'];

const jinglesStats = [
  { k: 'Speed', v: `${MOVEMENT.hunter}`, note: `You sprint at ${MOVEMENT.scrapperSprint}. It gains on you every second.` },
  { k: 'Dash', v: `${JINGLES.dash.speed}`, note: `For ${JINGLES.dash.durationSec} s, every ${JINGLES.dash.cooldownSec} s. No wind-up.` },
  { k: 'Bloodlust', v: `${JINGLES.bloodlust.everySec} s`, note: `Sees every Scrapper for ${JINGLES.bloodlust.revealSec} s and moves ${JINGLES.bloodlust.speedMult}× faster.` },
  { k: 'Hits to down', v: `${JINGLES.attack.hitsToDown}`, note: `Then it's the pod, or a ${JINGLES.executeSec}-second finish.` },
  { k: 'Tell', v: `${JINGLES.attack.windupSec} s`, note: 'A red danger zone flashes before every swing.' },
];

const compare = [
  ['Objective', 'Repair a fixed set of machines', `Find, carry and crush ${CRUSHERS.totalKg} kg of scrap across the whole map`],
  ['Tasks', 'One repeated skill check', `${MINIGAMES.length} console minigames, ${CRUSHERS.minigamesPerConsole} per crusher`],
  ['Threats', 'One killer', 'Jingles, plus Worms that surface where it gets loud'],
  ['Teamwork', 'Mostly side by side', `Two players per console, ${POD.rescueHoldSec}-second pod rescues, one shared weight goal`],
  ['The escape', 'Open the gate', `A ${EXTRACTION.windowSec}-second window and a personal UFO beam-out`],
];

const videoGameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  '@id': `${SITE.url}/#game`,
  name: GAME.name,
  alternateName: GAME.fullName,
  description: SITE.description,
  url: SITE.url,
  image: [
    new URL('/press/jingles-render.png', SITE.url).href,
    ...['central-room-globe', 'cargo-dock-shuttle', 'jingles-closeup', 'crusher-console'].map((id) => new URL(shot(id).full, SITE.url).href),
  ],
  screenshot: ROOM_INFO.map((r) => new URL(shot(r.shots[0]).full, SITE.url).href),
  genre: [...GAME.genres],
  gamePlatform: ['Roblox', ...GAME.platforms],
  operatingSystem: 'Roblox',
  applicationCategory: 'Game',
  playMode: ['MultiPlayer', 'CoOp'],
  numberOfPlayers: { '@type': 'QuantitativeValue', minValue: GAME.scrappers.min + GAME.hunters, maxValue: GAME.serverSize },
  datePublished: GAME.launchDate,
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', url: LINKS.game, availability: 'https://schema.org/InStock' },
  trailer: {
    '@type': 'VideoObject',
    name: FEATURED_VIDEO.title,
    description: FEATURED_VIDEO.note,
    thumbnailUrl: [new URL(`/yt/${FEATURED_VIDEO.id}.jpg`, SITE.url).href],
    uploadDate: FEATURED_VIDEO.date,
    embedUrl: `https://www.youtube.com/embed/${FEATURED_VIDEO.id}`,
    contentUrl: watchUrl(FEATURED_VIDEO.id),
  },
  author: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
  sameAs: [LINKS.game, LINKS.wikidataGame],
};
---

<BaseLayout title={SITE.title} path="/" ogImageAlt="Jingles, the clockwork jester Hunter from STATIC, next to the STATIC logo" jsonLd={[videoGameLd]}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" imagesrcset={heroShot.srcset} imagesizes="(min-width: 768px) 100vw, 50vw" fetchpriority="high" />
  </Fragment>

  <!-- Beat reveals: armed inline so above-fold copy paints on first frame.
       Fail-safe: no observer → nothing is hidden. -->
  <script is:inline>
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var io = null;
      var pending = [];
      function ensureIo() {
        if (io) return;
        var obs = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) if (entries[i].isIntersecting) entries[i].target.classList.add('in');
        }, { threshold: 0.12 });
        io = obs;
        document.documentElement.classList.add('js-beats');
        for (var k = 0; k < pending.length; k++) io.observe(pending[k]);
        pending.length = 0;
      }
      function arm() {
        var els = document.querySelectorAll('.beat:not([data-armed])');
        for (var j = 0; j < els.length; j++) {
          els[j].setAttribute('data-armed', '1');
          if (io) io.observe(els[j]); else pending.push(els[j]);
        }
        ensureIo();
      }
      arm();
      document.addEventListener('DOMContentLoaded', arm);
      setTimeout(function () {
        arm();
        if (!io) { document.documentElement.classList.remove('js-beats'); return; }
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var stuck = document.querySelectorAll('.beat:not(.in)');
        for (var j = 0; j < stuck.length; j++) {
          if (stuck[j].getBoundingClientRect().top < vh * 1.1) stuck[j].classList.add('in');
        }
      }, 5000);
    })();
  </script>

  <div class="progress-rail" aria-hidden="true"><div class="progress-rail-fill" id="progressFill"></div></div>

  <!-- ================= HERO ================= -->
  <section class="hero-cine" aria-label="STATIC">
    <div class="hero-cine-bg" aria-hidden="true">
      <!-- Phones see this backdrop under a heavy shade: 50vw picks the 640 file. -->
      <Shot id="central-room-globe" sizes="(min-width: 768px) 100vw, 50vw" eager alt="" />
    </div>
    <div class="hero-cine-shade" aria-hidden="true"></div>
    <canvas id="staticNoise" class="static-noise" aria-hidden="true"></canvas>

    <div class="relative mx-auto grid w-full max-w-6xl items-end gap-4 px-4 pt-24 pb-10 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:pt-16 lg:pb-0">
      <div class="hero-cine-copy">
        <p id="launchStatus" data-launch={SITE.launchDate} class="kicker flex items-center gap-3">
          <span class="dot" aria-hidden="true"></span>
          <span data-launch-label>Free on Roblox · Beta out {GAME.launchLabel}</span>
        </p>

        <h1 class="mt-6 font-display text-7xl font-bold uppercase leading-none tracking-tight sm:text-9xl">
          <span class="flicker text-signal" data-decode>Static</span>
        </h1>
        <p class="mt-2 font-display text-2xl font-semibold uppercase tracking-[0.14em] text-facility-100 sm:text-3xl">
          {GAME.tagline}
        </p>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-facility-100/85">
          A free co-op horror game on Roblox. Up to {GAME.scrappers.max} players search an abandoned
          bunker for scrap and haul {CRUSHERS.totalKg} kg of it to the crushers. One more player is
          <strong class="text-facility-100">Jingles</strong>, the Hunter, and Jingles is a little
          faster than you.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">
            Play free on Roblox <span aria-hidden="true">→</span>
          </a>
          <a href="#tour" class="btn-secondary bg-facility-950/40">
            Tour the bunker <span aria-hidden="true">↓</span>
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-[0.16em] text-facility-300">
          <li>{GAME.scrappers.min}–{GAME.scrappers.max} SCRAPPERS VS {GAME.hunters} HUNTER</li>
          <li>ROUNDS UP TO {GAME.roundLimitMin} MIN</li>
          <li>PC + MOBILE</li>
          <li>VOICE CHAT</li>
        </ul>
      </div>

      <div class="hero-art hero-cine-fg relative mx-auto w-full max-w-[16rem] self-end sm:max-w-xs lg:max-w-none">
        <img
          src="/img/jingles-720.webp"
          srcset="/img/jingles-360.webp 360w, /img/jingles-720.webp 418w, /img/jingles.webp 697w"
          sizes="(min-width: 1024px) 420px, 200px"
          width="418"
          height="720"
          fetchpriority="low"
          alt="Jingles, the Hunter in STATIC: a clockwork jester with a grinning skull mask, a belled jester cap and long metal claws"
          class="relative mx-auto h-auto max-h-[80svh] w-auto"
        />
      </div>
    </div>
    <span class="scroll-cue absolute bottom-6 left-1/2 hidden -translate-x-1/2 lg:inline-flex" aria-hidden="true">SCROLL</span>
  </section>

  <!-- Facts band (true numbers only — every item comes from data/game.ts) -->
  <div class="ticker border-y border-facility-700 bg-facility-900/80" aria-hidden="true">
    <div class="ticker-track font-mono text-[0.7rem] tracking-[0.3em] text-signal-dim">
      {[0, 1].map(() =>
        tickerItems.map((item) => (
          <span class="flex shrink-0 items-center gap-3 px-6 py-2.5">
            <span class="inline-block h-1.5 w-1.5 bg-signal/70" aria-hidden="true"></span>
            {item}
          </span>
        ))
      )}
    </div>
  </div>

  <!-- ================= NUMBERS ================= -->
  <section aria-label="STATIC in numbers" class="atmo-amber">
    <div class="mx-auto w-full max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {stats.map((st) => (
          <li class="stat rise">
            <div class="flex items-start justify-between">
              <Icon name={st.icon} size={28} class="stat-icon" />
              {st.gauge && (
                <svg width="56" height="56" viewBox="0 0 40 40" aria-hidden="true">
                  <circle cx="20" cy="20" r="16" fill="none" stroke-width="3" class="gauge-track" />
                  <circle cx="20" cy="20" r="16" fill="none" stroke-width="3" class="gauge-fill" pathLength="100" transform="rotate(-90 20 20)" />
                </svg>
              )}
            </div>
            <p class="mt-6">
              <span class="stat-num count" style={`--to: ${st.to}`}><span class="count-real">{st.to}</span></span>
              {st.unit && <span class="stat-unit">{st.unit}</span>}
            </p>
            <p class="mt-2 font-mono text-xs uppercase tracking-[0.16em] text-facility-300">{st.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= HOW A ROUND WORKS: sticky story ================= -->
  <section aria-labelledby="loop-h" id="how-to-play" class="border-t border-facility-800">
    <div class="mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6 sm:pt-32">
      <p class="kicker">How a round works</p>
      <h2 id="loop-h" class="beat mt-4 max-w-3xl font-display text-4xl font-bold uppercase tracking-wide sm:text-6xl" data-decode>
        Find it. Haul it. Crush it. Get out.
      </h2>
    </div>
    <div class="story mx-auto grid w-full max-w-6xl gap-10 px-4 pb-24 sm:px-6 lg:grid-cols-[1.35fr_0.65fr] lg:gap-14">
      <div class="story-media" aria-hidden="true">
        {loop.map((st) => (
          <div class="shot-frame">
            <Shot id={st.shot} sizes="(min-width: 1024px) 760px, 1px" alt="" imgClass="h-full w-full object-cover" imgStyle={`object-position: ${st.pos}`} />
            <div class="shot-caption">
              <p class="font-mono text-[0.68rem] tracking-[0.2em] text-signal">STEP {st.n}</p>
              <p class="mt-1 font-display text-3xl font-bold uppercase tracking-wide text-facility-100">{st.t}</p>
            </div>
          </div>
        ))}
      </div>
      <ol class="pt-12 lg:pt-0">
        {loop.map((st) => (
          <li class="story-step py-10">
            <div class="flex items-end gap-5">
              <span class="step-num" aria-hidden="true">{st.n}</span>
              <span class="step-icon"><Icon name={st.icon} size={26} /></span>
            </div>
            <h3 class="mt-5 font-display text-4xl font-bold uppercase tracking-wide sm:text-5xl">{st.t}</h3>
            <p class="mt-4 max-w-md text-lg leading-relaxed text-facility-300">{st.b}</p>
            <a href={st.link.href} class="mt-5 inline-block font-mono text-sm text-signal hover:text-signal-dim">{st.link.label} <span aria-hidden="true">→</span></a>
            <div class="step-inline reveal shot-frame aspect-[16/10]">
              <Shot id={st.shot} sizes="(min-width: 640px) 600px, 100vw" imgClass="h-full w-full object-cover" imgStyle={`object-position: ${st.pos}`} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= TOUR THE BUNKER (pinned horizontal on desktop) ================= -->
  <section class="tour border-t border-facility-800" id="tour" aria-labelledby="tour-h" style={`--tour-count: ${ROOM_INFO.length}`}>
    <div class="tour-pin py-20 lg:py-0">
      <div class="mx-auto mb-8 flex w-full max-w-6xl flex-wrap items-end justify-between gap-6 px-4 sm:px-6">
        <div>
          <p class="kicker">The map</p>
          <h2 id="tour-h" class="mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl">Tour the bunker</h2>
          <p class="mt-4 max-w-xl text-facility-300">
            One map in the beta, {ROOM_INFO.length}+ rooms. Every screenshot is from the game.
            <span class="lg:hidden">Swipe to look around.</span>
          </p>
        </div>
        <a href="/guide/map/" class="btn-secondary">Full map guide <span aria-hidden="true">→</span></a>
      </div>

      <ol class="strip" aria-label="Rooms of the bunker">
        {ROOM_INFO.map((r, i) => (
          <li class="tour-card">
            <a href={`/guide/map/#${r.slug}`} class="group block">
              <div class="shot-frame">
                <Shot id={r.shots[0]} sizes="(min-width: 1024px) 704px, 82vw" imgClass="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
                <div class="shot-caption">
                  <p class="font-mono text-[0.68rem] tracking-[0.2em] text-signal">{String(i + 1).padStart(2, '0')} / {String(ROOM_INFO.length).padStart(2, '0')}</p>
                  <p class="mt-1 font-display text-2xl font-bold uppercase tracking-wide text-facility-100 sm:text-3xl">{r.name}</p>
                </div>
              </div>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-facility-300">{r.blurb}</p>
            </a>
          </li>
        ))}
      </ol>

      <div class="mx-auto mt-8 hidden w-full max-w-6xl px-6 lg:block" aria-hidden="true">
        <div class="h-px w-full bg-facility-700"><div class="tour-progress h-px w-full bg-signal"></div></div>
      </div>
    </div>
  </section>

  <!-- ================= KINETIC BAND ================= -->
  <div class="border-y border-facility-800 py-10 sm:py-16" aria-hidden="true">
    <div class="kinetic"><div class="kinetic-l"><span class="kinetic-line kinetic-outline">Jingles is</span><span class="kinetic-line kinetic-solid">faster</span><span class="kinetic-line kinetic-outline">than you</span><span class="kinetic-line kinetic-signal">13.5</span></div></div>
    <div class="kinetic mt-2"><div class="kinetic-r"><span class="kinetic-line kinetic-signal">Don't</span><span class="kinetic-line kinetic-outline">ring the</span><span class="kinetic-line kinetic-solid">bell</span><span class="kinetic-line kinetic-outline">Don't ring the bell</span></div></div>
  </div>

  <!-- ================= JINGLES ================= -->
  <section class="atmo-red relative overflow-hidden" aria-labelledby="jingles-h" id="jingles">
    <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 sm:py-32 lg:grid-cols-[0.95fr_1.05fr]">
      <div class="order-2 grid gap-4 lg:order-1">
        <div class="reveal shot-frame aspect-[4/3]">
          <Shot id="jingles-closeup" sizes="(min-width: 1024px) 520px, 100vw" lightbox="jingles" imgClass="h-full w-full object-cover object-[50%_30%]" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="reveal shot-frame aspect-[4/3]">
            <Shot id="jingles-red" sizes="(min-width: 1024px) 260px, 50vw" lightbox="jingles" imgClass="h-full w-full object-cover object-[50%_35%]" />
          </div>
          <div class="reveal shot-frame aspect-[4/3]">
            <Shot id="jingles-medbay" sizes="(min-width: 1024px) 260px, 50vw" lightbox="jingles" imgClass="h-full w-full object-cover object-[60%_50%]" />
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <p class="noise-label text-status-red">The Hunter — 1 per round</p>
        <h2 id="jingles-h" class="beat mt-4 font-display text-4xl font-bold uppercase tracking-wide sm:text-6xl" data-decode>
          Meet Jingles
        </h2>
        <p class="beat mt-6 max-w-xl text-lg leading-relaxed text-facility-300">
          Not an AI. One real player in your server, every round, hunting everyone else.
        </p>

        <dl class="beat mt-10 divide-y divide-facility-700 border-y border-facility-700">
          {jinglesStats.map((s) => (
            <div class="grid grid-cols-[6.5rem_5.5rem_1fr] items-baseline gap-3 py-4 sm:grid-cols-[9rem_7rem_1fr] sm:gap-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-facility-500">{s.k}</dt>
              <dd class="whitespace-nowrap font-display text-xl font-bold text-signal sm:text-2xl">{s.v}</dd>
              <dd class="text-sm leading-relaxed text-facility-300">{s.note}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 font-mono text-[0.68rem] tracking-[0.14em] text-facility-500">SPEEDS IN STUDS PER SECOND. VALUES FROM THE BETA BUILD.</p>

        <p class="beat mt-8">
          <a href="/guide/jingles/" class="btn-secondary">Jingles: abilities and counterplay <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= THE OTHER THREATS ================= -->
  <section class="atmo-amber border-t border-facility-800" aria-labelledby="threats-h">
    <div class="relative mx-auto w-full max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <svg class="pointer-events-none absolute right-4 top-16 hidden h-32 w-[min(46rem,60%)] sm:block" viewBox="0 0 600 120" aria-hidden="true">
        <path class="draw-path" pathLength="1" d="M0 90 C 60 90, 70 30, 130 30 S 200 100, 260 95 S 330 20, 400 28 S 470 105, 540 80 S 585 40, 600 42" />
        <circle cx="600" cy="42" r="5" fill="currentColor" class="text-signal" />
      </svg>
      <p class="kicker">It's not only Jingles</p>
      <h2 id="threats-h" class="beat mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
        Two more ways to lose
      </h2>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        <article class="panel flex flex-col">
          <div class="reveal shot-frame aspect-[16/9] border-0 border-b">
            <Shot id="worm-render" sizes="(min-width: 1024px) 560px, 100vw" lightbox="threats" imgClass="h-full w-full object-cover" />
          </div>
          <div class="flex flex-1 flex-col p-7">
            <p class="noise-label text-signal">Under the floor</p>
            <h3 class="mt-3 font-display text-3xl font-bold uppercase leading-tight tracking-wide">The Worm</h3>
            <p class="mt-5 leading-relaxed text-facility-300">
              Ring your bell and it surfaces {WORM.bellSpawnDelaySec} seconds later. It grabs, drains
              {WORM.grabDamagePct}% health, and leaves.
            </p>
            <p class="mt-4 leading-relaxed text-facility-100">Hold your flashlight on it while it rears up and it backs off.</p>
            <a href="/guide/worm/" class="mt-auto pt-6 font-mono text-sm text-signal hover:text-signal-dim">How to survive the Worm <span aria-hidden="true">→</span></a>
          </div>
        </article>
