  <!-- Launch status: day-precision, so no fake launch hour is implied. -->
  <script>
    (function () {
      const el = document.getElementById('launchStatus');
      const label = el ? el.querySelector('[data-launch-label]') : null;
      if (!el || !label) return;
      const target = Date.parse((el.getAttribute('data-launch') || '') + 'T00:00:00');
      if (isNaN(target)) return;
      const days = Math.ceil((target - Date.now()) / 86400000);
      if (days <= 0) label.textContent = 'Free on Roblox · Beta live now';
      else if (days === 1) label.textContent = 'Free on Roblox · Beta out tomorrow';
      else label.textContent = 'Free on Roblox · Beta out in ' + days + ' days';
    })();
  </script>

  <!-- Progress rail: writes only inside rAF, one read per frame at most. -->
  <script>
    (function () {
      const fill = document.getElementById('progressFill');
      if (!fill) return;
      let ticking = false;
      const update = function () {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        fill.style.transform = 'scaleX(' + p + ')';
      };
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    })();
  </script>

  <!-- Hero static: analog TV noise painted to a small buffer. Dies on
       reduced-motion, hidden tabs, or off-screen. -->
  <script>
    (function () {
      const canvas = document.getElementById('staticNoise') as HTMLCanvasElement | null;
      if (!canvas || !canvas.getContext) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const W = 110;
      const H = 62;
      const buf = document.createElement('canvas');
      buf.width = W; buf.height = H;
      const bctx = buf.getContext('2d');
      if (!bctx) return;
      const img = bctx.createImageData(W, H);
      let running = true;
      document.addEventListener('visibilitychange', () => { running = !document.hidden; });
      const sizeCanvas = function () {
        canvas.width = canvas.clientWidth;
        canvas.height = canvas.clientHeight;
      };
      sizeCanvas();
      window.addEventListener('resize', sizeCanvas);
      let rafId = 0;
      let frame = 0;
      const draw = function () {
        // ~20fps: static is noise — more frames add nothing but main-thread cost.
        frame = (frame + 1) % 3;
        if (frame === 0 && running) {
          const d = img.data;
          for (let i = 0; i < d.length; i += 4) {
            const v = (Math.random() * 255) | 0;
            d[i] = v; d[i + 1] = v; d[i + 2] = v;
            d[i + 3] = 255;
          }
          bctx.putImageData(img, 0, 0);
          ctx.drawImage(buf, 0, 0, canvas.width, canvas.height);
        }
        rafId = requestAnimationFrame(draw);
      };
      const start = function () {
        if (rafId) return;
        const kick = function () { if (!rafId) rafId = requestAnimationFrame(draw); };
        if ('requestIdleCallback' in window) requestIdleCallback(kick, { timeout: 1500 });
        else (window as any).setTimeout(kick, 400);
      };
      const stop = function () { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(function (entries) {
          for (const e of entries) { if (e.isIntersecting) start(); else stop(); }
        });
        io.observe(canvas);
      } else {
        start();
      }
    })();
  </script>
