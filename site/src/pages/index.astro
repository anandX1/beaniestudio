---
/**
 * Homepage — the visual hook, then three visual doors, then the CTA.
 *
 * Rewritten 2026-10 round (visual redesign):
 *
 * DELETED, because each block's content already exists elsewhere on the site:
 *   - kinetic type band   (aria-hidden, zero words, and the source of the
 *                          158.4px / 9.9x display-size outlier)
 *   - parallax band       (0 words, 1 image, no function; the image also
 *                          appears in the stills rack below)
 *   - endings block       (result-escaped is rendered inside step 04; the
 *                          other three are UI screenshots, now reachable in
 *                          the stills rack)
 *   - team block          (SiteFooter says "three-person team"; /about/ lists
 *                          all three with roles and emails)
 *   - FollowSection       (duplicates SiteFooter's Discord / YouTube / Roblox
 *                          links; its one unique affordance, the Share button,
 *                          survives in the community strip)
 *
 * UN-PINNED, content kept: "How a round works" and "Tour the bunker" were a
 * sticky scrollytelling column and a pinned horizontal scroll-jack. Measured
 * together at 8.71 viewports — 42% of the page — for 325 words and 16 images.
 * They are now a hairline column grid and a room grid: same content, no
 * hijacked scroll axis, and no sticky boxes to break LCP or anchors.
 *
 * Type, colour and rhythm come from the v3 vocabulary in styles/global.css
 * (.eyebrow / .label / .readout / .spec / .strip-row / .plate / .rack) and
 * from the scale tokens (text-caption, text-body, text-lead, text-title,
 * text-display). No new colour literal is written here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import Shot from '../components/Shot.astro';
import Lightbox from '../components/Lightbox.astro';
import Icon from '../components/Icon.astro';
import { SITE, LINKS } from '../site.config';
import { FEATURED_VIDEO, VIDEOS, watchUrl } from '../data/videos';
import { shot, SHOTS } from '../data/media';
import { ROOM_INFO } from '../data/rooms';
import {
  GAME, MOVEMENT, JINGLES, POD, SCRAP, CRUSHERS, MINIGAMES, EXTRACTION, WORM, ROADMAP, COMMUNITY, RESULTS,
} from '../data/game';

const lightest = SCRAP[0];
const heaviest = SCRAP[SCRAP.length - 1];
const heroShot = shot('central-room-globe');

/** The four hard numbers of the job, plus one line that places each of them. */
const jobStats = [
  { v: `${CRUSHERS.totalKg}`, u: 'kg', n: 'of scrap, crushed to clear the round' },
  { v: `${CRUSHERS.count}`, u: '', n: 'crushers, in random spots. Crushing is loud' },
  { v: `${MINIGAMES.length}`, u: '', n: `console minigames; ${CRUSHERS.minigamesPerConsole} per crusher` },
  { v: `${GAME.roundLimitMin}`, u: 'min', n: 'is the longest a round runs' },
];

/** 01–04. `pos` is the crop, not decoration: two steps share a console shot. */
const loop = [
  {
    n: '01', t: 'Scavenge', icon: 'scrap' as const, shot: 'storage-bay', pos: '50% 50%',
    b: `${SCRAP.length} kinds of scrap, ${lightest.kg} kg to ${heaviest.kg} kg. Two backpack slots. Heavy stuff goes in your hands.`,
    link: { href: '/guide/scrap/', label: 'Every scrap item' },
  },
  {
    n: '02', t: 'Crush', icon: 'crusher' as const, shot: 'crusher-console', pos: '18% 50%',
    b: `${CRUSHERS.count} crushers, random spots, ${CRUSHERS.totalKg} kg to feed. Crushing is loud.`,
    link: { href: '/guide/crushers/', label: 'How crushers work' },
  },
  {
    n: '03', t: 'Calibrate', icon: 'console' as const, shot: 'crusher-console', pos: '82% 50%',
    b: `${CRUSHERS.minigamesPerConsole} minigames per console, from a pool of ${MINIGAMES.length}. Fail one and it faults.`,
    link: { href: '/guide/crushers/#minigames', label: `All ${MINIGAMES.length} minigames` },
  },
  {
    n: '04', t: 'Escape', icon: 'exit' as const, shot: 'result-escaped', pos: '50% 30%',
    b: `The ${EXTRACTION.room} opens for ${EXTRACTION.windowSec} seconds. Make it and a UFO beams you out.`,
    link: { href: '/guide/', label: 'Beginner guide' },
  },
];

/** The shared section still: one framed plate, two steps of the sequence. */
const roundStills = [loop[0], loop[2]];

const jinglesStats = [
  { k: 'Speed', v: `${MOVEMENT.hunter}`, note: `You sprint at ${MOVEMENT.scrapperSprint}. It gains on you every second.` },
  { k: 'Dash', v: `${JINGLES.dash.speed}`, note: `For ${JINGLES.dash.durationSec} s, every ${JINGLES.dash.cooldownSec} s. No wind-up.` },
  { k: 'Bloodlust', v: `${JINGLES.bloodlust.everySec} s`, warn: true, note: `Sees every Scrapper for ${JINGLES.bloodlust.revealSec} s and moves ${JINGLES.bloodlust.speedMult}× faster.` },
  { k: 'Hits to down', v: `${JINGLES.attack.hitsToDown}`, note: `Then it's the pod, or a ${JINGLES.executeSec}-second finish.` },
  { k: 'Tell', v: `${JINGLES.attack.windupSec} s`, note: 'A red danger zone flashes before every swing.' },
];

const compare = [
  ['Objective', 'Repair a fixed set of machines', `Find, carry and crush ${CRUSHERS.totalKg} kg of scrap across the whole map`],
  ['Tasks', 'One repeated skill check', `${MINIGAMES.length} console minigames, ${CRUSHERS.minigamesPerConsole} per crusher`],
  ['Threats', 'One killer', 'Jingles, plus Worms that surface where it gets loud'],
  ['Teamwork', 'Mostly side by side', `Two players per console, ${POD.rescueHoldSec}-second pod rescues, one shared weight goal`],
  ['The escape', 'Open the gate', `A ${EXTRACTION.windowSec}-second window and a personal UFO beam-out`],
];

/**
 * The stills rack. These are the same 20 shots the deleted marquee carried —
 * 8 of which appeared nowhere else on the homepage — so the rack keeps every
 * one of them reachable rather than turning them into dead texture. Each tile
 * links to the gallery group that holds it (the group indices are the same
 * `GROUPS` order /screenshots/ renders, so the anchor is stable).
 */
const STILL_GROUPS: { key: string[]; slug: string }[] = [
  { key: ['jingles'], slug: '#g0' },
  { key: ['room', 'map'], slug: '#g1' },
  { key: ['objective', 'pod', 'worm'], slug: '#g2' },
  { key: ['ui'], slug: '#g3' },
  { key: ['round', 'hallway'], slug: '#g4' },
];
const stillTile = (id: string) => {
  const s = shot(id);
  const g = STILL_GROUPS.find((x) => x.key.includes(s.group));
  return {
    id,
    label: (s.room || s.id.replace(/-/g, ' ')).toUpperCase(),
    href: `/screenshots/${g ? g.slug : ''}`,
  };
};
const stills = [
  'cargo-dock-shuttle', 'reactor-coils', 'medbay', 'control-room-hologram', 'storage-bay',
  'jingles-red', 'central-room-globe', 'interrogation', 'cargo-dock-floor', 'security',
  'jingles-medbay', 'reactor-tanks', 'storage-bay-forklift', 'control-room', 'worm-render',
  'pod-active', 'medbay-red', 'hunter-reveal', 'cargo-dock-bay', 'reactor-door',
].map(stillTile);

/** The two full-bleed closing plates: one room, one corridor. */
const closingStills = [
  {
    id: 'reactor-tanks',
    room: 'Nuclear Reactor',
    line: 'Red-glowing coils, then green tanks. The loudest room on the map.',
    href: '/guide/map/',
    link: 'The map, room by room',
    side: 'left' as const,
  },
  {
    id: 'security',
    room: 'Security',
    line: 'A wall of monitors over the only desk nobody watches.',
    href: '/screenshots/',
    link: `All ${SHOTS.length} screenshots`,
    side: 'right' as const,
  },
];

/** The three videos past the featured one, each reduced to a title row. */
const moreVideos = VIDEOS.slice(1, 4);
const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

const videoGameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  '@id': `${SITE.url}/#game`,
  name: GAME.name,
  alternateName: GAME.fullName,
  description: SITE.description,
  url: SITE.url,
  image: [
    new URL('/press/jingles-render.png', SITE.url).href,
    ...['central-room-globe', 'cargo-dock-shuttle', 'jingles-closeup', 'crusher-console'].map((id) => new URL(shot(id).full, SITE.url).href),
  ],
  screenshot: ROOM_INFO.map((r) => new URL(shot(r.shots[0]).full, SITE.url).href),
  genre: [...GAME.genres],
  gamePlatform: ['Roblox', ...GAME.platforms],
  operatingSystem: 'Roblox',
  applicationCategory: 'Game',
  playMode: ['MultiPlayer', 'CoOp'],
  numberOfPlayers: { '@type': 'QuantitativeValue', minValue: GAME.scrappers.min + GAME.hunters, maxValue: GAME.serverSize },
  datePublished: GAME.launchDate,
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', url: LINKS.game, availability: 'https://schema.org/InStock' },
  trailer: {
    '@type': 'VideoObject',
    name: FEATURED_VIDEO.title,
    description: FEATURED_VIDEO.note,
    thumbnailUrl: [new URL(`/yt/${FEATURED_VIDEO.id}.jpg`, SITE.url).href],
    uploadDate: FEATURED_VIDEO.date,
    embedUrl: `https://www.youtube.com/embed/${FEATURED_VIDEO.id}`,
    contentUrl: watchUrl(FEATURED_VIDEO.id),
  },
  author: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
  sameAs: [LINKS.game, LINKS.wikidataGame],
};
---

<BaseLayout title={SITE.title} path="/" biome="hub" ogImageAlt="Jingles, the clockwork jester Hunter from STATIC, next to the STATIC logo" jsonLd={[videoGameLd]}>
  <Fragment slot="head">
    <!-- Unchanged on purpose: the hero image is the measured LCP element and
         `100vw` is correct for a full-bleed backdrop. Declaring 1280 here would
         upscale it above 1440. -->
    <link rel="preload" as="image" type="image/avif" imagesrcset={heroShot.srcset.replace(/\.webp/g, '.avif')} imagesizes="(min-width: 768px) 100vw, 50vw" fetchpriority="high" />
  </Fragment>

  <!-- Beat reveals: armed inline so above-fold copy paints on first frame.
       Fail-safe: no observer → nothing is hidden. The script bails on
       prefers-reduced-motion, so reduced-motion users never get the class and
       never see an armed element. Nothing inside the first 100svh carries
       .beat — that is what keeps the hero out of the reveal system. -->
  <script is:inline>
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var io = null;
      var pending = [];
      function sweep() {
        var stuck = document.querySelectorAll('.beat:not(.in)');
        if (!stuck.length) return;
        var limit = (window.innerHeight || document.documentElement.clientHeight) * 1.1;
        var reveal = [];
        for (var i = 0; i < stuck.length; i++) {
          if (stuck[i].getBoundingClientRect().top < limit) reveal.push(stuck[i]);
        }
        for (var j = 0; j < reveal.length; j++) reveal[j].classList.add('in');
      }

      function ensureIo() {
        if (io) return;
        io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) entries[i].target.classList.add('in');
          }
        }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
        document.documentElement.classList.add('js-beats');
        for (var k = 0; k < pending.length; k++) io.observe(pending[k]);
        pending.length = 0;
      }
      function arm() {
        var els = document.querySelectorAll('.beat:not([data-armed])');
        for (var j = 0; j < els.length; j++) {
          els[j].setAttribute('data-armed', '1');
          if (io) io.observe(els[j]); else pending.push(els[j]);
        }
        ensureIo();
      }
      arm();
      document.addEventListener('DOMContentLoaded', arm);
      // Safety net: an IntersectionObserver is sampled once per frame, so a hard
      // flick can carry an element past the viewport without it ever being reported
      // as intersecting, leaving it permanently at opacity 0 (measured 0-5 of 41
      // headings, varying run to run). A trailing sweep after the scroll settles
      // makes that impossible. This is a correctness fallback, not a scroll-driven
      // animation. Rects are read before any class is written: interleaving the two
      // dirties style on every iteration and forces a full recalculation per element.
      var sweepTimer = 0;
      window.addEventListener('scroll', function () {
        if (sweepTimer) clearTimeout(sweepTimer);
        sweepTimer = setTimeout(sweep, 120);
      }, { passive: true });

      // Above-fold copy must never wait for a scroll event to appear.
      setTimeout(function () { arm(); sweep(); }, 600);
      setTimeout(sweep, 2500);
    })();
  </script>

  <div class="progress-rail" aria-hidden="true"><div class="progress-rail-fill" id="progressFill"></div></div>

  <!-- ================= 01 · HOOK — hero ================= -->
  <section class="hero-cine" aria-label="STATIC">
    <!-- The LCP element. No opacity gate, no clip-path, no mask: it paints at
         full visibility on the first frame and only its `filter` settles in
         (global.css, `signal-acquire`). -->
    <div class="hero-cine-bg" aria-hidden="true">
      <!-- Phones see this backdrop under a heavy shade: 50vw picks the 640 file. -->
      <Shot id="central-room-globe" sizes="(min-width: 768px) 100vw, 50vw" eager />
    </div>
    <div class="hero-cine-shade" aria-hidden="true"></div>
    <canvas id="staticNoise" class="static-noise" aria-hidden="true"></canvas>

    <div class="relative mx-auto grid w-full max-w-6xl items-end gap-4 px-4 pt-16 pb-10 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:pt-16 lg:pb-0">
      <div class="hero-cine-copy">
        <p id="launchStatus" data-launch={SITE.launchDate} class="eyebrow">
          <span class="dot" aria-hidden="true"></span>
          <span data-launch-label>Free on Roblox · Beta out {GAME.launchLabel}</span>
        </p>

        <!-- The H1 carries the game's full name, not just "Static": "STATIC"
             alone collides with the generic word and with other games, so the
             ownable term is the long form. Sized from the scale's display step
             (44 → 96px) instead of a hand-written text-7xl/text-9xl pair. -->
        <h1 class="mt-6 font-display text-display font-bold uppercase tracking-tight">
          <span class="flicker block text-signal" data-decode>Static</span>
          <span class="mt-2 block font-display text-title font-semibold uppercase tracking-[0.14em] text-facility-100">
            {GAME.tagline}
          </span>
        </h1>

        <p class="mt-7 max-w-xl text-lead text-facility-100/85">
          A free co-op horror game on Roblox. Up to {GAME.scrappers.max} Scrappers search an abandoned
          bunker for scrap and haul {CRUSHERS.totalKg} kg of it to the crushers. One more player is
          <strong class="text-facility-100">Jingles</strong>, the Hunter, and Jingles is a little
          faster than you.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">
            Play free on Roblox <span aria-hidden="true"><Icon name="arrow-right" inline /></span>
          </a>
        </div>

        <!-- The four facts the 42s ticker used to scroll past. Static, readable,
             above the fold, and no amber: the ticker painted 10 text elements
             with text-signal-dim by inheritance. -->
        <ul class="strip-row mt-10 label">
          <li>{GAME.scrappers.min}–{GAME.scrappers.max} SCRAPPERS VS {GAME.hunters} HUNTER</li>
          <li>ROUNDS UP TO {GAME.roundLimitMin} MIN</li>
          <li>{GAME.platforms.join(' + ').toUpperCase()}</li>
          <li>VOICE CHAT</li>
        </ul>
      </div>

      <div class="hero-art hero-cine-fg relative mx-auto w-full max-w-[16rem] self-end sm:max-w-xs lg:max-w-none">
        <img
          src="/img/jingles-720.webp"
          srcset="/img/jingles-360.webp 360w, /img/jingles-720.webp 418w, /img/jingles.webp 697w"
          sizes="(min-width: 1024px) 420px, 200px"
          width="418"
          height="720"
          fetchpriority="low"
          alt="Jingles, the Hunter in STATIC: a clockwork jester with a grinning skull mask, a belled jester cap and long metal claws"
          class="relative mx-auto h-auto max-h-[80svh] w-auto"
        />
      </div>
    </div>
    <span class="scroll-cue absolute bottom-6 left-1/2 hidden -translate-x-1/2 lg:inline-flex" aria-hidden="true">SCROLL</span>
  </section>

  <!-- ================= 02 · THE JOB — four numbers =================
       NOT opted into `.cis`. It is 529px tall at 1440 and 477px at 390 — both
       under the viewport, so `content-visibility: auto` can never skip it (an
       element that fits the viewport is always relevant to it). Adding the class
       would only add a path where a wrong intrinsic size could bite, for zero
       saved work. -->
  <section class="section-band border-t border-facility-800" aria-labelledby="job-h">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <p class="eyebrow">The job</p>
      <h2 id="job-h" class="rise mt-4 max-w-3xl font-display text-title font-bold uppercase tracking-wide" data-decode>
        Find {CRUSHERS.totalKg} kg of scrap. Crush it. Get out.
      </h2>
      <div class="mt-8 ticks" aria-hidden="true"></div>
      <ul class="strip-row mt-8">
        {jobStats.map((st) => (
          <li class="flex flex-1 flex-col gap-1">
            <span class="readout--xl">{st.v}{st.u && <u>{st.u}</u>}</span>
            <span class="label">{st.n}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= 03 · THE ROUND — was the sticky scrollytelling column =================
       Un-pinned. Four cells on one hairline grid, one shared still at the foot.
       Previously: a 4-frame sticky crossfade plus 4 duplicate inline images on
       mobile, at 3.87 viewports. -->
  <section class="cis section-band border-t border-facility-800" id="how-to-play" aria-labelledby="loop-h">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <p class="eyebrow">The round</p>
      <h2 id="loop-h" class="rise mt-4 max-w-3xl font-display text-title font-bold uppercase tracking-wide" data-decode>
        Find it. Haul it. Crush it. Get out.
      </h2>
      <div class="mt-8 ticks" aria-hidden="true"></div>

      <ol class="mt-10 grid gap-x-6 gap-y-10 border-t border-facility-700 pt-8 sm:grid-cols-2 lg:grid-cols-4">
        {loop.map((st, i) => (
          <li class="rise flex flex-col border-l border-facility-800 pl-5" style={`--i: ${i}`}>
            <span class="rule mb-4 w-6" style="background: var(--color-signal)" aria-hidden="true"></span>
            <p class="flex items-center gap-3">
              <span class="label">{st.n}</span>
              <span class="step-icon" aria-hidden="true"><Icon name={st.icon} size={18} /></span>
            </p>
            <h3 class="mt-4 font-display text-2xl font-bold uppercase tracking-wide">{st.t}</h3>
            <p class="mt-3 text-body text-facility-300">{st.b}</p>
            <a href={st.link.href} class="link mt-auto pt-5 font-mono text-xs uppercase tracking-[0.08em]">
              {st.link.label}
            </a>
          </li>
        ))}
      </ol>

      <!-- One shared still, framed as a monitor, instead of four images of which
           two were the same file. -->
      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        {roundStills.map((st, i) => (
          <figure class="rise plate plate--scan aspect-[16/9]" style={`--i: ${i}`}>
            <Shot id={st.shot} sizes="(min-width: 640px) 600px, 100vw" imgClass="h-full w-full object-cover" imgStyle={`object-position: ${st.pos}`} />
            <figcaption class="absolute bottom-0 left-0 right-0 p-3 label">
              {st.n} · {st.t}
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-4 text-sm text-facility-500">
        <a href="/guide/" class="link">The beginner guide covers all four steps in order</a>
      </p>
    </div>
  </section>

  <!-- ================= 04 · THE MAP — was the pinned tour =================
       Un-pinned. Eight rooms as one grid at three columns, each tile a whole-tile
       link to its room on /guide/map/. Previously a pinned horizontal scroll-jack
       at 4.84 viewports with a caption scrim covering 30% of every shot.
       Largest contained section on mobile (2876px content box). -->
  <section class="cis section-band border-t border-facility-800" id="tour" aria-labelledby="tour-h">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <p class="eyebrow">The map</p>
      <h2 id="tour-h" class="rise mt-4 max-w-3xl font-display text-title font-bold uppercase tracking-wide">
        One map. {ROOM_INFO.length} rooms. No safe corners.
      </h2>
      <div class="mt-8 ticks" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-body text-facility-300">
        One map in the beta. Every screenshot on this page is captured in the game.
      </p>

      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-label="Rooms of the bunker">
        {ROOM_INFO.map((r, i) => (
          <li class="rise" style={`--i: ${i}`}>
            <a href={`/guide/map/#${r.slug}`} class="group block">
              <div class="plate plate--scan aspect-[16/9]">
                <Shot id={r.shots[0]} sizes="(min-width: 1024px) 440px, (min-width: 640px) 50vw, 100vw" imgClass="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
              </div>
              <p class="mt-3 flex items-baseline gap-3">
                <span class="label">{String(i + 1).padStart(2, '0')} / {String(ROOM_INFO.length).padStart(2, '0')}</span>
                <span class="font-display text-xl font-bold uppercase tracking-wide text-facility-100 group-hover:text-signal">{r.name}</span>
              </p>
              <p class="mt-1.5 text-sm text-facility-300">{r.blurb}</p>
            </a>
          </li>
        ))}
      </ol>

      <p class="mt-8">
        <a href="/guide/map/" class="btn-secondary">Full map guide <span aria-hidden="true"><Icon name="arrow-right" inline /></span></a>
      </p>
    </div>
  </section>

  <!-- ================= 05 · THE HUNTER — Jingles, the Worm and the Pod =================
       Merged from "Meet Jingles" + "Two more ways to lose". Asymmetric on
       purpose (rule 7): a 3/5 close-up beside a 2/5 column of two half-height
       plates, then one spec table. One amber value out of five, not five. -->
  <section class="cis section-band border-t border-facility-800" id="jingles" aria-labelledby="jingles-h">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <p class="eyebrow label--warn">The Hunter — 1 per round</p>
      <h2 id="jingles-h" class="rise mt-4 max-w-3xl font-display text-title font-bold uppercase tracking-wide" data-decode>
        Meet Jingles
      </h2>
      <div class="mt-8 ticks" aria-hidden="true"></div>
      <p class="rise mt-6 max-w-2xl text-lead text-facility-300">
        Not an AI. One real player in your server, every round, hunting everyone else.
      </p>

      <div class="mt-10 grid gap-4 lg:grid-cols-[3fr_2fr]">
        <figure class="rise plate plate--scan aspect-[16/10] lg:aspect-auto lg:min-h-[26rem]">
          <Shot id="jingles-closeup" sizes="(min-width: 1024px) 720px, 100vw" lightbox="jingles" imgClass="h-full w-full object-cover object-[50%_30%]" />
          <figcaption class="absolute bottom-0 left-0 right-0 p-3 label">Jingles · in the bunker</figcaption>
        </figure>

