---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import FollowSection from '../components/FollowSection.astro';
import { SITE, LINKS } from '../site.config';
import { FEATURED_VIDEO, VIDEOS, watchUrl } from '../data/videos';
import {
  GAME, MOVEMENT, JINGLES, POD, SCRAP, CRUSHERS, MINIGAMES, EXTRACTION, WORM, ROADMAP, TEAM, COMMUNITY, SCRAPPER,
} from '../data/game';

const lightest = SCRAP[0];
const heaviest = SCRAP[SCRAP.length - 1];

const tickerItems = [
  `CRUSHER QUOTA: ${CRUSHERS.totalKg} KG`,
  `HUNTER BLOODLUST: EVERY ${JINGLES.bloodlust.everySec} SECONDS`,
  `POD TIMER: ${POD.timerSec} SECONDS`,
  `EXTRACTION WINDOW: ${EXTRACTION.windowSec} SECONDS`,
  'DO NOT RING THE BELL',
  'THE WORM HATES LIGHT',
];

const loop = [
  {
    n: '01',
    t: 'Scavenge',
    b: `Search the bunker for scrap: ${SCRAP.length} kinds, from a ${lightest.kg} kg ${lightest.name.toLowerCase()} to a ${heaviest.kg} kg ${heaviest.name.toLowerCase()}. Small parts go in your ${SCRAPPER.backpackSlots} backpack slots. The heavy ones go in your hands, and you'll feel it.`,
  },
  {
    n: '02',
    t: 'Crush',
    b: `${CRUSHERS.count} crushers spawn in different places every round. Feed them ${CRUSHERS.quotasKg.join(', ').replace(/, (\d+)$/, ' and $1')} kg: ${CRUSHERS.totalKg} kg in total. Crushing scrap is not quiet.`,
  },
  {
    n: '03',
    t: 'Calibrate',
    b: `A full crusher unlocks its console: ${CRUSHERS.minigamesPerConsole} quick minigames drawn from ${MINIGAMES.length}, like ${MINIGAMES.slice(0, 4).join(', ').toLowerCase()} and ${MINIGAMES[9].toLowerCase()}. Two players can work one console side by side. Mess one up and the console faults, loudly.`,
  },
  {
    n: '04',
    t: 'Extract',
    b: `Finish all ${CRUSHERS.count} crushers and the ${EXTRACTION.room} opens for ${EXTRACTION.windowSec} seconds. Reach it and a UFO beams you out. Escaping is personal: you make it, or you don't.`,
  },
];

const jinglesStats = [
  { k: 'Speed', v: `${MOVEMENT.hunter}`, note: `You sprint at ${MOVEMENT.scrapperSprint}. It gains on you every second.` },
  { k: 'Dash', v: `${JINGLES.dash.speed}`, note: `For ${JINGLES.dash.durationSec} s, every ${JINGLES.dash.cooldownSec} s. No wind-up.` },
  { k: 'Bloodlust', v: `${JINGLES.bloodlust.everySec} s`, note: `Sees every Scrapper for ${JINGLES.bloodlust.revealSec} s and moves ${JINGLES.bloodlust.speedMult}× faster.` },
  { k: 'Hits to down', v: `${JINGLES.attack.hitsToDown}`, note: `Then it's the pod, or a ${JINGLES.executeSec}-second finish.` },
  { k: 'Tell', v: `${JINGLES.attack.windupSec} s`, note: 'A red danger zone flashes before every swing.' },
];

const compare = [
  ['Objective', 'Repair a fixed set of machines', `Find, carry and crush ${CRUSHERS.totalKg} kg of scrap across the whole map`],
  ['Tasks', 'One repeated skill check', `${MINIGAMES.length} console minigames, ${CRUSHERS.minigamesPerConsole} per crusher`],
  ['Threats', 'One killer', 'Jingles, plus Worms that surface where it gets loud'],
  ['Teamwork', 'Mostly side by side', `Two players per console, ${POD.rescueHoldSec}-second pod rescues, one shared weight goal`],
  ['The escape', 'Open the gate', `A ${EXTRACTION.windowSec}-second window and a personal UFO beam-out`],
];

const pageImage = new URL('/press/jingles-render.png', SITE.url).href;

const videoGameLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  '@id': `${SITE.url}/#game`,
  name: GAME.name,
  alternateName: GAME.fullName,
  description: SITE.description,
  url: SITE.url,
  image: pageImage,
  genre: [...GAME.genres],
  gamePlatform: ['Roblox', ...GAME.platforms],
  operatingSystem: 'Roblox',
  applicationCategory: 'Game',
  playMode: ['MultiPlayer', 'CoOp'],
  numberOfPlayers: { '@type': 'QuantitativeValue', minValue: GAME.scrappers.min + GAME.hunters, maxValue: GAME.serverSize },
  datePublished: GAME.launchDate,
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', url: LINKS.game, availability: 'https://schema.org/InStock' },
  trailer: {
    '@type': 'VideoObject',
    name: FEATURED_VIDEO.title,
    description: FEATURED_VIDEO.note,
    thumbnailUrl: [new URL(`/yt/${FEATURED_VIDEO.id}.jpg`, SITE.url).href],
    uploadDate: FEATURED_VIDEO.date,
    embedUrl: `https://www.youtube.com/embed/${FEATURED_VIDEO.id}`,
    contentUrl: watchUrl(FEATURED_VIDEO.id),
  },
  author: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
  sameAs: [LINKS.game, LINKS.wikidataGame],
};
---

<BaseLayout title={SITE.title} path="/" ogImageAlt="Jingles, the clockwork jester Hunter from STATIC, next to the STATIC logo" jsonLd={[videoGameLd]}>
  <!-- Arm the beat reveals INLINE (not in the deferred bundle) so above-fold
       beats paint on first frame. Fail-safe: no observer → nothing hidden. -->
  <script is:inline>
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var io = null;
      var pending = [];
      function ensureIo() {
        if (io) return;
        var obs = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) if (entries[i].isIntersecting) entries[i].target.classList.add('in');
        }, { threshold: 0.12 });
        io = obs;
        document.documentElement.classList.add('js-beats');
        for (var k = 0; k < pending.length; k++) io.observe(pending[k]);
        pending.length = 0;
      }
      function arm() {
        var els = document.querySelectorAll('.beat:not([data-armed])');
        for (var j = 0; j < els.length; j++) {
          els[j].setAttribute('data-armed', '1');
          if (io) io.observe(els[j]); else pending.push(els[j]);
        }
        ensureIo();
      }
      arm();
      document.addEventListener('DOMContentLoaded', arm);
      setTimeout(function () {
        arm();
        if (!io) { document.documentElement.classList.remove('js-beats'); return; }
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var stuck = document.querySelectorAll('.beat:not(.in)');
        for (var j = 0; j < stuck.length; j++) {
          if (stuck[j].getBoundingClientRect().top < vh * 1.1) stuck[j].classList.add('in');
        }
      }, 5000);
    })();
  </script>

  <div class="progress-rail" aria-hidden="true"><div class="progress-rail-fill" id="progressFill"></div></div>

  <!-- ================= HERO ================= -->
  <section class="hero relative overflow-hidden" aria-label="STATIC">
    <canvas id="staticNoise" class="static-noise" aria-hidden="true"></canvas>
    <div class="relative mx-auto grid w-full max-w-6xl items-center gap-6 px-4 pt-14 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:pt-10">
      <div class="py-6 lg:py-20">
        <p id="launchStatus" data-launch={SITE.launchDate} class="kicker flex items-center gap-3">
          <span class="dot" aria-hidden="true"></span>
          <span data-launch-label>Free on Roblox · Beta out {GAME.launchLabel}</span>
        </p>

        <h1 class="beat mt-6 font-display text-7xl font-bold uppercase leading-none tracking-tight sm:text-9xl">
          <span class="flicker text-signal" data-decode>Static</span>
        </h1>
        <p class="beat mt-2 font-display text-2xl font-semibold uppercase tracking-[0.14em] text-facility-100 sm:text-3xl" style="--beat-delay: 90ms">
          {GAME.tagline}
        </p>

        <p class="beat mt-7 max-w-xl text-lg leading-relaxed text-facility-300" style="--beat-delay: 160ms">
          A free co-op horror game on Roblox. Up to {GAME.scrappers.max} players search an abandoned
          bunker for scrap and haul {CRUSHERS.totalKg} kg of it to the crushers. One more player is
          <strong class="text-facility-100">Jingles</strong>, the Hunter, and Jingles is a little
          faster than you.
        </p>

        <div class="beat mt-9 flex flex-wrap items-center gap-4" style="--beat-delay: 230ms">
          <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">
            Play free on Roblox <span aria-hidden="true">→</span>
          </a>
          <a href={LINKS.discord} rel="noopener" target="_blank" class="btn-secondary">
            Join the Discord <span aria-hidden="true">→</span>
          </a>
        </div>

        <ul class="beat mt-10 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-[0.16em] text-facility-500" style="--beat-delay: 300ms">
          <li>{GAME.scrappers.min}–{GAME.scrappers.max} SCRAPPERS VS {GAME.hunters} HUNTER</li>
          <li>ROUNDS UP TO {GAME.roundLimitMin} MIN</li>
          <li>PC + MOBILE</li>
          <li>VOICE CHAT</li>
        </ul>
      </div>

      <div class="hero-art relative mx-auto w-full max-w-sm self-end lg:max-w-none">
        <img
          src="/img/jingles-720.webp"
          srcset="/img/jingles-480.webp 279w, /img/jingles-720.webp 418w, /img/jingles.webp 697w"
          sizes="(min-width: 1024px) 420px, 280px"
          width="418"
          height="720"
          alt="Jingles, the Hunter in STATIC: a clockwork jester with a grinning skull mask, a belled jester cap and long metal claws"
          fetchpriority="high"
          class="relative mx-auto h-auto max-h-[78svh] w-auto"
        />
      </div>
    </div>
  </section>

  <!-- Facts band (true numbers only — every item comes from data/game.ts) -->
  <div class="ticker border-t border-facility-700 bg-facility-900/60" aria-hidden="true">
    <div class="ticker-track font-mono text-[0.7rem] tracking-[0.3em] text-signal-dim">
      {[0, 1].map(() =>
        tickerItems.map((item) => (
          <span class="flex shrink-0 items-center gap-3 px-6 py-2.5">
            <span class="inline-block h-1.5 w-1.5 bg-signal/70" aria-hidden="true"></span>
            {item}
          </span>
        ))
      )}
    </div>
  </div>

  <!-- ================= FOOTAGE ================= -->
  <section class="border-t border-facility-800" aria-label="Gameplay videos" id="videos">
    <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6">
      <p class="kicker">Gameplay</p>
      <h2 class="beat mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
        Footage from the bunker
      </h2>

      <div class="mt-12 grid gap-6 lg:grid-cols-5">
        <div class="beat lg:col-span-3">
          <VideoCard video={FEATURED_VIDEO} />
        </div>
        <div class="beat panel flex flex-col justify-between gap-6 p-7 lg:col-span-2" style="--beat-delay: 120ms">
          <div>
            <p class="kicker">From the team's channel</p>
            <p class="mt-4 font-display text-2xl font-bold uppercase leading-snug tracking-wide text-facility-100">
              {COMMUNITY.youtubeViews} views and counting
            </p>
            <p class="mt-4 text-sm leading-relaxed text-facility-300">
              Shorts from playtests, chases and bad hiding spots, plus devlogs on how the game gets
              built. New uploads every week.
            </p>
          </div>
          <a href={LINKS.youtube} target="_blank" rel="noopener" class="btn-secondary self-start">
            Watch on YouTube <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {VIDEOS.slice(1, 4).map((v, i) => (
          <div class="beat" style={`--beat-delay: ${i * 110}ms`}>
            <VideoCard video={v} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= HOW A ROUND WORKS ================= -->
  <section class="border-t border-facility-800" aria-label="How a round works" id="how-to-play">
    <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6">
      <p class="kicker">How a round works</p>
      <h2 class="beat mt-4 max-w-3xl font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
        Find it. Haul it. Crush it. Get out.
      </h2>
      <p class="beat mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
        Scrappers spawn together in the central hub. Jingles is released shortly after, from one
        of {GAME.hunterSpawnPoints} random spots. A round lasts up to
        {GAME.roundLimitMin} minutes; if time runs out, the Hunter wins.
      </p>

      <ol class="mt-14 grid gap-px border border-facility-700 bg-facility-700 md:grid-cols-2">
        {loop.map((s, i) => (
          <li class="beat bg-facility-900 p-8" style={`--beat-delay: ${(i % 2) * 110}ms`}>
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-sm text-signal-dim" aria-hidden="true">{s.n}</span>
              <h3 class="font-display text-2xl font-bold uppercase tracking-wide">{s.t}</h3>
            </div>
            <p class="mt-4 leading-relaxed text-facility-300">{s.b}</p>
          </li>
        ))}
      </ol>

      <p class="beat mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm">
        <a href="/guide/" class="text-signal hover:text-signal-dim">Full beginner's guide <span aria-hidden="true">→</span></a>
        <a href="/guide/scrap/" class="text-signal hover:text-signal-dim">Every scrap item and its weight <span aria-hidden="true">→</span></a>
        <a href="/guide/crushers/" class="text-signal hover:text-signal-dim">Crushers and minigames <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ================= JINGLES ================= -->
  <section class="border-t border-facility-800" aria-label="Meet Jingles, the Hunter" id="jingles">
    <div class="mx-auto grid w-full max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="beat hunter-portrait panel relative order-2 overflow-hidden lg:order-1">
        <img
          src="/img/jingles-closeup.webp"
          width="640"
          height="664"
          loading="lazy"
          decoding="async"
          alt="Close-up of Jingles: a grinning skull mask under a red, navy and brown jester cap with brass bells"
          class="relative mx-auto block h-auto w-full max-w-md pt-10"
        />
        <div class="hunter-fade" aria-hidden="true"></div>
        <p class="absolute bottom-4 left-5 font-mono text-[0.68rem] tracking-[0.2em] text-facility-300">SUBJECT: JINGLES · CLASS: HUNTER</p>
      </div>

      <div class="order-1 lg:order-2">
        <p class="noise-label text-status-red">The Hunter — 1 per round</p>
        <h2 class="beat mt-4 font-display text-4xl font-bold uppercase tracking-wide sm:text-6xl" data-decode>
          Meet Jingles
        </h2>
        <p class="beat mt-6 max-w-xl text-lg leading-relaxed text-facility-300">
          Jingles is not an AI. It's one of the players in your server, picked each round, playing
          a clockwork jester with a grinning skull mask and claws for hands. The rest of the
          server is trying to get away from it.
        </p>

        <dl class="beat mt-10 divide-y divide-facility-700 border-y border-facility-700">
          {jinglesStats.map((s) => (
            <div class="grid grid-cols-[6.5rem_5.5rem_1fr] items-baseline gap-3 py-4 sm:grid-cols-[9rem_7rem_1fr] sm:gap-4">
              <dt class="font-mono text-xs uppercase tracking-widest text-facility-500">{s.k}</dt>
              <dd class="whitespace-nowrap font-display text-xl font-bold text-signal sm:text-2xl">{s.v}</dd>
              <dd class="text-sm leading-relaxed text-facility-300">{s.note}</dd>
            </div>
          ))}
        </dl>
        <p class="mt-3 font-mono text-[0.68rem] tracking-[0.14em] text-facility-500">SPEEDS IN STUDS PER SECOND. VALUES FROM THE BETA BUILD.</p>

        <p class="beat mt-8">
          <a href="/guide/jingles/" class="btn-secondary">Jingles: abilities and counterplay <span aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- ================= THE OTHER THREATS ================= -->
  <section class="border-t border-facility-800" aria-label="The Worm and the pods">
    <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6">
      <p class="kicker">It's not only Jingles</p>
      <h2 class="beat mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
        Two more ways to lose
      </h2>

      <div class="split mt-12">
        <div class="beat">
          <p class="noise-label text-signal">Under the floor</p>
          <h3 class="mt-3 font-display text-3xl font-bold uppercase leading-tight tracking-wide">The Worm</h3>
          <p class="mt-5 leading-relaxed text-facility-300">
            Every Scrapper carries a bell they can't drop. Ring it and a Worm surfaces
            {WORM.bellSpawnDelaySec} seconds later. Missed throws, heavy scrap and screaming mimic
            items can draw one too. It grabs you, drains {WORM.grabDamagePct}% of your health and
            leaves.
          </p>
          <p class="mt-4 leading-relaxed text-facility-100">
            Hold your flashlight on it while it rears up and it backs off.
          </p>
          <a href="/guide/worm/" class="mt-6 inline-block font-mono text-sm text-signal hover:text-signal-dim">How to survive the Worm <span aria-hidden="true">→</span></a>
        </div>
        <div class="beat" style="--beat-delay: 140ms">
          <p class="noise-label text-status-red">After the second hit</p>
          <h3 class="mt-3 font-display text-3xl font-bold uppercase leading-tight tracking-wide">The Pod</h3>
          <p class="mt-5 leading-relaxed text-facility-300">
            Go down and Jingles can carry you to a pod. You get {POD.timerSec} seconds. A teammate
            holds E for {POD.rescueHoldSec} seconds to break you out. If nobody's left free to save
            you, the timer runs twice as fast.
          </p>
          <p class="mt-4 leading-relaxed text-facility-100">
            Jingles can't just stand guard: camping a pod overloads it, stuns the Hunter and sets
            you free.
          </p>
          <a href="/guide/capture-and-rescue/" class="mt-6 inline-block font-mono text-sm text-signal hover:text-signal-dim">Capture and rescue, explained <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= WHAT'S DIFFERENT ================= -->
  <section class="border-t border-facility-800" aria-label="How STATIC is different">
    <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6">
      <p class="kicker">Why we built it</p>
      <h2 class="beat mt-4 max-w-3xl font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
        Not another generator game
      </h2>
      <p class="beat mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
        Most asymmetrical horror games compete on graphics and keep the same loop: fix the
        machines, open the gate. We wanted the survivors' side to be its own game, where you
        explore, decide what's worth carrying and work as a team.
      </p>

      <div class="beat mt-12 overflow-x-auto border border-facility-700">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead class="bg-facility-900 font-mono text-xs uppercase tracking-widest text-facility-500">
            <tr>
              <th scope="col" class="w-36 px-5 py-4 font-normal"></th>
              <th scope="col" class="px-5 py-4 font-normal">Most asymmetrical horror</th>
              <th scope="col" class="px-5 py-4 font-normal text-signal">STATIC</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-facility-700">
            {compare.map(([k, them, us]) => (
              <tr>
                <th scope="row" class="px-5 py-4 font-mono text-xs uppercase tracking-widest text-facility-500">{k}</th>
                <td class="px-5 py-4 text-facility-500">{them}</td>
                <td class="px-5 py-4 text-facility-100">{us}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= ROADMAP ================= -->
  <section class="border-t border-facility-800" aria-label="Roadmap">
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-4 py-24 sm:px-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="kicker">Planned — not in the beta yet</p>
        <h2 class="beat mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
          What's next
        </h2>
        <p class="beat mt-6 text-lg leading-relaxed text-facility-300">
          The beta is one map and one Hunter. Here's what the team is building next. The
          Discord votes on the order.
        </p>
        <a href={LINKS.discord} rel="noopener" target="_blank" class="beat btn-secondary mt-8">Vote in the Discord <span aria-hidden="true">→</span></a>
      </div>
      <ul class="divide-y divide-facility-700 border-y border-facility-700">
        {ROADMAP.map((r, i) => (
          <li class="beat py-5" style={`--beat-delay: ${i * 60}ms`}>
            <h3 class="font-display text-lg font-bold uppercase tracking-wide">{r.t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-facility-300">{r.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= TEAM ================= -->
  <section class="border-t border-facility-800" aria-label="The team">
    <div class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6">
      <p class="kicker">Who makes it</p>
      <h2 class="beat mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl" data-decode>
        Built by three people
      </h2>
      <p class="beat mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
        {SITE.name} started STATIC in {GAME.devStarted} and rebuilt it three times before the
        first beta. No publisher, no outsourcing: everything in the game was made by the three of us.
      </p>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {TEAM.map((m, i) => (
          <li class="beat panel p-7" style={`--beat-delay: ${i * 100}ms`}>
            <p class="font-display text-xl font-bold uppercase tracking-wide">{m.name}</p>
            <p class="mt-2 text-sm leading-relaxed text-facility-300">{m.role}</p>
            <p class="mt-4 font-mono text-xs text-facility-500">ROBLOX: {m.roblox}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FollowSection />

  <!-- ================= FINAL CTA ================= -->
  <section class="border-t border-facility-800" aria-label="Play STATIC">
    <div class="mx-auto w-full max-w-6xl px-4 py-24 text-center sm:px-6">
      <p class="kicker">Free · {GAME.platforms.join(' + ')} · Roblox</p>
      <h2 class="beat mt-4 font-display text-4xl font-bold uppercase tracking-wide sm:text-6xl" data-decode>
        The bunker is open
      </h2>
      <p class="beat mx-auto mt-5 max-w-xl text-facility-300" style="--beat-delay: 100ms">
        Grab your squad, pick up your flashlight, and leave the bell alone.
      </p>
      <div class="beat mt-9 flex flex-wrap items-center justify-center gap-4" style="--beat-delay: 200ms">
        <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">Play free on Roblox <span aria-hidden="true">→</span></a>
        <a href="/guide/" class="btn-secondary">Read the guide first <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Launch status: day-precision, so no fake launch hour is implied. -->
  <script>
    (function () {
      const el = document.getElementById('launchStatus');
      const label = el ? el.querySelector('[data-launch-label]') : null;
      if (!el || !label) return;
      const target = Date.parse((el.getAttribute('data-launch') || '') + 'T00:00:00');
      if (isNaN(target)) return;
      const days = Math.ceil((target - Date.now()) / 86400000);
      if (days <= 0) label.textContent = 'Free on Roblox · Beta live now';
      else if (days === 1) label.textContent = 'Free on Roblox · Beta out tomorrow';
      else label.textContent = 'Free on Roblox · Beta out in ' + days + ' days';
    })();
  </script>

  <!-- Progress rail: writes only inside rAF, one read per frame at most. -->
  <script>
    (function () {
      const fill = document.getElementById('progressFill');
      if (!fill) return;
      let ticking = false;
      const update = function () {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        fill.style.transform = 'scaleX(' + p + ')';
      };
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    })();
  </script>

  <!-- Hero static: analog TV noise painted to a small buffer. Dies on
       reduced-motion, hidden tabs, or off-screen. -->
  <script>
    (function () {
      const canvas = document.getElementById('staticNoise') as HTMLCanvasElement | null;
      if (!canvas || !canvas.getContext) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const W = 110;
      const H = 62;
      const buf = document.createElement('canvas');
      buf.width = W; buf.height = H;
      const bctx = buf.getContext('2d');
      if (!bctx) return;
      const img = bctx.createImageData(W, H);
      let running = true;
      document.addEventListener('visibilitychange', () => { running = !document.hidden; });
      const sizeCanvas = function () {
        canvas.width = canvas.clientWidth;
        canvas.height = canvas.clientHeight;
      };
      sizeCanvas();
      window.addEventListener('resize', sizeCanvas);
      let rafId = 0;
      let parity = 0;
      const draw = function () {
        parity ^= 1;
        if (parity && running) {
          const d = img.data;
          for (let i = 0; i < d.length; i += 4) {
            const v = (Math.random() * 255) | 0;
            d[i] = v; d[i + 1] = v; d[i + 2] = v;
            d[i + 3] = 255;
          }
          bctx.putImageData(img, 0, 0);
          ctx.drawImage(buf, 0, 0, canvas.width, canvas.height);
        }
        rafId = requestAnimationFrame(draw);
      };
      const start = function () {
        if (rafId) return;
        const kick = function () { if (!rafId) rafId = requestAnimationFrame(draw); };
        if ('requestIdleCallback' in window) requestIdleCallback(kick, { timeout: 600 });
        else (window as any).setTimeout(kick, 120);
      };
      const stop = function () { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(function (entries) {
          for (const e of entries) { if (e.isIntersecting) start(); else stop(); }
        });
        io.observe(canvas);
      } else {
        start();
      }
    })();
  </script>
</BaseLayout>
