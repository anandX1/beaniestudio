---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('devlog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="Devlog — building STATIC, piece by piece"
  description="Development updates on STATIC: Salvage vs Hunter — sound design, onboarding, balance, and the road to launch. Straight from Beanie Studio."
  path="/devlog"
  ogImage="/og/devlog.png"
  breadcrumb={[{ name: 'Mission brief', path: '/' }, { name: 'Devlog', path: '/devlog' }]}
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="kicker">Development log</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      Devlog
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      Build notes from the facility — what shipped, what broke, and what we learned. Also on
      YouTube as full devlogs.
    </p>

    <div class="mt-14 space-y-6">
      {posts.map((post) => (
        <article class="panel p-7 transition-colors hover:border-signal-dim">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="font-display text-2xl font-bold uppercase tracking-wide">
              <a href={`/devlog/${post.id}/`} class="hover:text-signal">{post.data.title}</a>
            </h2>
            <time datetime={post.data.pubDate.toISOString()} class="font-mono text-xs text-facility-500">
              {fmt(post.data.pubDate)}
            </time>
          </div>
          <p class="mt-4 leading-relaxed text-facility-300">{post.data.description}</p>
          <a href={`/devlog/${post.id}/`} class="mt-5 inline-flex items-center gap-2 font-mono text-sm text-signal hover:text-signal-dim">
            Read entry <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
