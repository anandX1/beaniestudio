---
/**
 * /about/ — the studio page.
 *
 * Why it exists: every other page answers a question about the game. This is the
 * one that answers "who is behind this, and are they real?" — the E-E-A-T signal
 * that a young domain otherwise has no way to demonstrate. It is also where a
 * journalist, a creator or a partner should land when they are not looking for
 * gameplay facts.
 *
 * Every claim here comes from src/data/game.ts, TEAM, or src/site.config.ts.
 * Nothing is asserted about the studio that the site does not already say
 * elsewhere (rule 9: if it is not in the data, the site does not claim it).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS, CHANNELS } from '../site.config';
import { GAME, TEAM } from '../data/game';
import Icon from '../components/Icon.astro';

const peopleLd = TEAM.map((m) => ({
  '@type': 'Person',
  name: m.name,
  jobTitle: m.title,
  email: m.email,
  worksFor: { '@id': `${SITE.url}/#org` },
  knowsAbout: m.knowsAbout,
}));

const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${SITE.url}/about/#page`,
  name: `About ${SITE.name}`,
  description: `${SITE.name} is an independent studio making ${GAME.name}, a free co-op horror game on Roblox.`,
  url: new URL('/about/', SITE.url).href,
  mainEntity: { '@id': `${SITE.url}/#org` },
  about: { '@id': `${SITE.url}/#org` },
  publisher: { '@id': `${SITE.url}/#org` },
  mentions: peopleLd,
};
---

<BaseLayout
  title={`About ${SITE.name} — the team behind STATIC`}
  description={`${SITE.name} is an independent studio making ${GAME.name}, a free co-op horror game on Roblox. Who we are, how to reach us, and where to get press assets.`}
  path="/about"
  ogImageAlt={`${SITE.name}, the studio behind STATIC`}
  jsonLd={[aboutLd]}
  breadcrumb={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <nav aria-label="Breadcrumb" class="font-mono text-xs tracking-[0.14em] text-facility-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-signal">HOME</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="text-facility-300">ABOUT</span></li>
      </ol>
    </nav>

    <p class="kicker mt-10">The studio</p>
    <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      {SITE.name}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-100">
      We are an independent studio of {TEAM.length} people. We make{' '}
      <strong class="text-facility-100">{GAME.name}</strong> — {GAME.fullName} — a free co-op horror
      game on Roblox.
    </p>
    <p class="mt-5 max-w-2xl leading-relaxed text-facility-300">
      No publisher, no outsourcing: the same small team designs, builds, animates, sounds and
      ships the whole game, and runs this site. We started work in {GAME.devStarted}, and the
      public beta went live on {GAME.launchLabel}.
    </p>

    <dl class="mt-12 grid gap-px border border-facility-700 bg-facility-700 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { k: 'Studio', v: SITE.name },
        { k: 'Team size', v: `${TEAM.length} people` },
        { k: 'Building since', v: GAME.devStarted },
        { k: 'Public beta', v: GAME.launchLabel },
      ].map((row) => (
        <div class="bg-facility-900 p-6">
          <dt class="font-mono text-xs uppercase tracking-widest text-facility-500">{row.k}</dt>
          <dd class="mt-2 font-display text-xl font-bold uppercase tracking-wide text-facility-100">{row.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="who-h" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="kicker">Who makes it</p>
      <h2 id="who-h" class="mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl">
        {TEAM.length} people, one game
      </h2>
      <p class="mt-5 max-w-2xl leading-relaxed text-facility-300">
        Everyone here works on {GAME.name} directly. If you need to reach a specific person about
        their area, the address is below — otherwise {SITE.contact} reaches all of us.
      </p>

      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {TEAM.map((m) => (
          <li class="panel p-7">
            <p class="font-mono text-xs uppercase tracking-widest text-signal-dim">{m.title}</p>
            <h3 class="mt-2 font-display text-xl font-bold uppercase tracking-wide text-facility-100">{m.name}</h3>
            <p class="mt-3 text-sm leading-relaxed text-facility-300">{m.role}</p>
            <a href={`mailto:${m.email}`} class="mt-5 inline-block font-mono text-xs text-facility-300 hover:text-signal">{m.email}</a>
          </li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-xs tracking-[0.14em] text-facility-500">
        IN-GAME HANDLES FOR ALL THREE ARE LISTED IN THE <a href="/press/" class="text-signal hover:text-signal-dim">PRESS KIT</a>.
      </p>
    </div>
  </section>

  <section aria-labelledby="contact-h" class="atmo-amber border-t border-facility-800">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-2">
      <div>
        <p class="kicker">Contact</p>
        <h2 id="contact-h" class="mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl">
          Reach us
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-facility-300">
          Media, creators, partners and players all get a reply from a person, not a form.
        </p>
        <ul class="mt-8 divide-y divide-facility-700 border-y border-facility-700">
          <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
            <span class="font-mono text-xs uppercase tracking-widest text-facility-500">General &amp; partners</span>
            <a href={`mailto:${SITE.contact}`} class="font-mono text-sm text-signal hover:text-signal-dim">{SITE.contact}</a>
          </li>
          <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
            <span class="font-mono text-xs uppercase tracking-widest text-facility-500">Press &amp; creators</span>
            <a href={`mailto:${SITE.press}`} class="font-mono text-sm text-signal hover:text-signal-dim">{SITE.press}</a>
          </li>
          <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
            <span class="font-mono text-xs uppercase tracking-widest text-facility-500">Community</span>
            <a href={LINKS.discord} rel="noopener" target="_blank" class="font-mono text-sm text-signal hover:text-signal-dim">Discord <Icon name="arrow-up-right" inline /></a>
          </li>
        </ul>
        <p class="mt-8">
          <a href="/press/" class="btn-secondary">Press kit &amp; fact sheet <span aria-hidden="true"><Icon name="arrow-right" inline /></span></a>
        </p>
      </div>

      <div>
        <p class="kicker">Where to find us</p>
        <h2 class="mt-4 font-display text-3xl font-bold uppercase tracking-wide sm:text-5xl">
          Official channels
        </h2>
        <p class="mt-5 max-w-xl leading-relaxed text-facility-300">
          These are the only accounts we run. Anything else claiming to be {SITE.name} is not us.
        </p>
        <ul class="mt-8 divide-y divide-facility-700 border-y border-facility-700">
          {CHANNELS.map((ch) => (
            <li class="py-4">
              <a href={ch.url} rel="noopener" target={ch.url.startsWith('http') ? '_blank' : undefined} class="group flex flex-wrap items-baseline justify-between gap-3">
                <span class="font-display text-base font-bold uppercase tracking-wide text-facility-100 group-hover:text-signal">{ch.name}</span>
                <span class="font-mono text-xs text-facility-300">{ch.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="next-h" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="next-h" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Start here
      </h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { href: '/play/', label: 'Play STATIC', blurb: 'Free on Roblox, PC and mobile.' },
          { href: '/guide/', label: "Beginner's guide", blurb: 'How a round actually works.' },
          { href: '/videos/', label: 'Videos', blurb: 'Gameplay and devlogs.' },
          { href: '/blog/', label: 'Devlog', blurb: 'How the game gets built.' },
        ].map((s) => (
          <li class="panel p-5">
            <a href={s.href} class="font-display text-lg font-bold uppercase tracking-wide hover:text-signal">
              {s.label} <span aria-hidden="true"><Icon name="arrow-right" inline /></span>
            </a>
            <p class="mt-2 text-sm leading-relaxed text-facility-300">{s.blurb}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
