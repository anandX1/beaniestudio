---
/**
 * /community/ — the hub for "is there a STATIC wiki / where is everyone".
 *
 * Gap from content/keywords-game.json. Deliberately NOT at /wiki/: there is no official
 * wiki yet, and a page pretending otherwise would be dishonest and would compete with
 * the Fandom article we are actively asking editors to write. Instead this page says
 * plainly that a wiki is in progress, hands editors the canonical data to build one
 * from, and collects every community channel in one place.
 *
 * It also serves the backlink strategy: the fastest way to get a wiki editor to link
 * us is to hand them a verified, citeable source of facts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS, CHANNELS } from '../site.config';
import { GAME, COMMUNITY, TEAM, CRUSHERS, SCRAP, JINGLES, MINIGAMES } from '../data/game';
import Icon from '../components/Icon.astro';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'STATIC community resources',
  description: `Where to find the STATIC community, and where to get verified facts about the game.`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Discord', url: LINKS.discord },
    { '@type': 'ListItem', position: 2, name: 'Roblox group', url: LINKS.roblox },
    { '@type': 'ListItem', position: 3, name: 'The game on Roblox', url: LINKS.game },
    { '@type': 'ListItem', position: 4, name: 'Official numbers reference', url: new URL('/guide/numbers/', SITE.url).href },
    { '@type': 'ListItem', position: 5, name: 'Press kit', url: new URL('/press/', SITE.url).href },
  ],
};
---

<BaseLayout
  title="STATIC Community and Wiki — Beanie Studios"
  description={`Where the STATIC community lives on Roblox: Discord, the Roblox group, how to report a bug — plus the verified facts to use if you are writing a wiki page.`}
  path="/community"
  ogImageAlt="STATIC community, Discord and wiki resources"
  jsonLd={[itemListLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Community', path: '/community' }]}
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="kicker">Community</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      Where the community lives
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-100">
      {SITE.name} is a three-person studio and {GAME.name} is in public beta, so the community is small
      and the people answering you are the people making the game. Here is where everything is.
    </p>
  </section>

  <section aria-labelledby="channels-h" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="channels-h" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        The channels we actually run
      </h2>
      <p class="mt-3 max-w-2xl text-facility-300">
        These are the official accounts. Anything else claiming to be {SITE.name} is not us.
      </p>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {CHANNELS.map((ch) => (
          <li class="panel p-6">
            <a href={ch.url} rel="noopener" target={ch.url.startsWith('http') ? '_blank' : undefined} class="group block">
              <span class="font-display text-lg font-bold uppercase tracking-wide text-facility-100 group-hover:text-signal">
                {ch.name} <span aria-hidden="true"><Icon name="arrow-up-right" inline /></span>
              </span>
              <span class="mt-1.5 block font-mono text-xs text-facility-500">{ch.handle}</span>
              <span class="mt-3 block text-sm leading-relaxed text-facility-300">{ch.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 font-mono text-xs tracking-[0.14em] text-facility-500">
        {COMMUNITY.discordMembers} IN THE DISCORD · {COMMUNITY.youtubeSubs} ON YOUTUBE · AS OF {COMMUNITY.asOf.toUpperCase()}
      </p>
    </div>
  </section>

  <section aria-labelledby="wiki-h" class="atmo-blue border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="wiki-h" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Is there a STATIC wiki?
      </h2>
      <p class="mt-5 max-w-3xl leading-relaxed text-facility-300">
        <strong class="text-facility-100">Not yet — and we would rather help you build one than run a
        bad one ourselves.</strong> There is no official wiki at the moment. If you want to start one,
        or you already edit Roblox wikis, everything below is verified and free to reuse.
      </p>

      <h3 class="mt-10 font-display text-lg font-bold uppercase tracking-wide text-facility-100">
        Verified facts, ready to copy
      </h3>
      <ul class="mt-4 space-y-2">
        <li>
          <a href="/guide/numbers/" class="link">Every number in STATIC</a> — player counts, all{' '}
          {SCRAP.length} scrap weights, the {CRUSHERS.totalKg} kg quota, movement speeds,{' '}
          {JINGLES.name}'s abilities and every timer. Generated from the game's own config, so it
          cannot go stale.
        </li>
        <li>
          <a href="/llms.txt" class="link">/llms.txt</a> — the same facts as plain text, written for
          editors and AI tools.
        </li>
        <li>
          <a href="/screenshots/" class="link">Official screenshots</a> — free to use for coverage,
          with attribution to {SITE.name}.
        </li>
        <li>
          <a href="/guide/" class="link">The official guide</a> — one page per mechanic: the{' '}
          <a href="/guide/map/" class="link">map</a>,{' '}
          <a href="/guide/jingles/" class="link">{JINGLES.name}</a>,{' '}
          <a href="/guide/worm/" class="link">the Worm</a>,{' '}
          <a href="/guide/scrap/" class="link">scrap</a>,{' '}
          <a href="/guide/crushers/" class="link">crushers and the {MINIGAMES.length} minigames</a>.
        </li>
      </ul>

      <div class="callout mt-8">
        <strong>Writing about {GAME.name}?</strong> There is no need to ask. Assets are free to use for
        coverage, and if you need a figure confirmed against the live build, email{' '}
        <a href={`mailto:${SITE.press}`}>{SITE.press}</a>. If we get something wrong, tell us and we
        will correct it — including on this site.
      </div>
    </div>
  </section>

  <section aria-labelledby="help-h" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="help-h" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        How to help
      </h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { t: 'Report a bug', b: `Post it in the Discord with what you were doing and what happened. A clip is worth ten paragraphs.`, href: LINKS.discord, external: true },
          { t: 'Send a clip', b: `Funny rounds, bad hiding spots and close calls are what we repost. The Discord has a channel for it.`, href: LINKS.discord, external: true },
          { t: 'Vote on updates', b: `The roadmap order is decided in the Discord, not by us in private.`, href: '/', external: false },
          { t: 'Make videos', b: `Free to stream and monetise. The creator page has the details and the assets.`, href: '/creators/', external: false },
          { t: 'Report a mistake on this site', b: `If a number here disagrees with the game, we want to know. Email or Discord both work.`, href: `mailto:${SITE.contact}`, external: false },
          { t: 'Write the wiki', b: `Seriously. Everything you need is above, and you will be faster at it than we are.`, href: '#wiki-h', external: false },
        ].map((c) => (
          <li class="panel p-6">
            <a
              href={c.href}
              rel={c.external ? 'noopener' : undefined}
              target={c.external ? '_blank' : undefined}
              class="font-display text-lg font-bold uppercase tracking-wide hover:text-signal"
            >
              {c.t} <span aria-hidden="true"><Icon name={c.external ? 'arrow-up-right' : 'arrow-right'} inline /></span>
            </a>
            <p class="mt-2 text-sm leading-relaxed text-facility-300">{c.b}</p>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-sm text-facility-300">
        The people behind all of this: {TEAM.map((t) => `${t.name} (${t.title})`).join(', ')}. More on{' '}
        <a href="/about/" class="link">the studio page</a>.
      </p>
    </div>
  </section>
</BaseLayout>
