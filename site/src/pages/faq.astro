---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS } from '../site.config';
import { GAME, JINGLES, CRUSHERS, POD, EXTRACTION, MOVEMENT, TEAM } from '../data/game';

/** Plain-text answers (they feed FAQPage JSON-LD verbatim); `link` adds a follow-up link on the page. */
const faqs: { q: string; a: string; link?: { href: string; label: string } }[] = [
  {
    q: 'What is STATIC on Roblox?',
    a: `STATIC is a free co-op horror game on Roblox by ${SITE.name}. Up to ${GAME.scrappers.max} players, called Scrappers, search an abandoned bunker for scrap and feed ${CRUSHERS.totalKg} kg of it into ${CRUSHERS.count} crushers, then escape. One more player is the Hunter, a clockwork jester called Jingles, who tries to catch them first.`,
    link: { href: '/guide/', label: 'Read the beginner guide' },
  },
  {
    q: 'Is STATIC free?',
    a: 'Yes. STATIC is free to play on Roblox. The beta has no paid items.',
  },
  {
    q: 'When did STATIC come out?',
    a: `The public beta launched on ${GAME.launchLabel}. The game has been in development since ${GAME.devStarted}.`,
  },
  {
    q: 'What devices can I play STATIC on?',
    a: 'PC and mobile (phones and tablets), in the same servers. Console is not officially supported yet.',
  },
  {
    q: 'How many players are in a round?',
    a: `Up to ${GAME.serverSize} per server: ${GAME.scrappers.min} to ${GAME.scrappers.max} Scrappers and ${GAME.hunters} Hunter.`,
  },
  {
    q: 'How long is a round?',
    a: `Up to ${GAME.roundLimitMin} minutes. If time runs out before the Scrappers escape, the Hunter wins.`,
  },
  {
    q: 'How do you win as a Scrapper?',
    a: `Complete all ${CRUSHERS.count} crushers (fill each one with scrap, then clear its console minigames) and reach the ${EXTRACTION.room} within ${EXTRACTION.windowSec} seconds of it opening. Winning is personal: every Scrapper who escapes wins.`,
    link: { href: '/guide/crushers/', label: 'Crushers, minigames and escape' },
  },
  {
    q: 'Who is Jingles?',
    a: `Jingles is the Hunter in STATIC: a clockwork jester played by one of the players in your server. It moves at ${MOVEMENT.hunter} studs per second (a sprinting Scrapper does ${MOVEMENT.scrapperSprint}), has a Dash, and every ${JINGLES.bloodlust.everySec} seconds its Bloodlust reveals every Scrapper for a moment.`,
    link: { href: '/guide/jingles/', label: 'Jingles: abilities and counters' },
  },
  {
    q: 'How is the Hunter chosen?',
    a: 'A new Hunter is picked each round. Who hunted last time, some luck, and playing with friends all affect the pick.',
  },
  {
    q: 'What happens when Jingles catches you?',
    a: `After ${JINGLES.attack.hitsToDown} hits you are downed. Jingles can finish you or carry you to a pod, where you have ${POD.timerSec} seconds for a teammate to rescue you (hold E for ${POD.rescueHoldSec} seconds). If the timer runs out, you are out of the round.`,
    link: { href: '/guide/capture-and-rescue/', label: 'Pods and rescue' },
  },
  {
    q: 'What is the Worm?',
    a: 'A creature under the bunker floor that surfaces near Scrappers, grabs them and drains health. Ringing your bell always summons one. Holding your flashlight on it makes it back off.',
    link: { href: '/guide/worm/', label: 'How to survive the Worm' },
  },
  {
    q: 'Does STATIC have voice chat?',
    a: 'Yes. Players with Roblox voice chat enabled can talk in-game, with echo that matches the bunker.',
  },
  {
    q: 'What age is STATIC for?',
    a: `It is made for players ${GAME.ageTarget}. It is a horror game with a monster, chases and jump scares. Check the game's Roblox page for its current maturity label.`,
  },
  {
    q: 'Are there STATIC codes?',
    a: 'Not yet. Codes are planned. When they go live, they will be listed on the official codes page and in the Discord at the same time.',
    link: { href: '/codes/', label: 'Official codes page' },
  },
  {
    q: 'Who makes STATIC?',
    a: `${SITE.name}, a team of three: ${TEAM.map((t) => t.name).join(', ')}.`,
    link: { href: '/press/', label: 'About the team' },
  },
  {
    q: 'Where do I report bugs or suggest features?',
    a: 'In the Discord. Bug reports there go straight to the three developers, and the community votes on what gets built next.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="STATIC FAQ — Price, Devices, Players, Jingles"
  description="Answers about STATIC on Roblox: is it free, what devices it runs on, how many players, round length, Jingles, the Worm, voice chat and codes."
  path="/faq"
  ogImage="/og/faq.png"
  jsonLd={[faqLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq' }]}
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-24">
    <p class="kicker">FAQ</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      STATIC: questions, answered
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      Straight answers about the game, checked against the beta build. Something missing? Ask in
      the Discord.
    </p>

    <div class="mt-14 divide-y divide-facility-700 border-y border-facility-700">
      {faqs.map((f, i) => (
        <details class="group py-5" open={i < 3}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-lg font-semibold uppercase tracking-wide text-facility-100 transition-colors group-open:text-signal">
            <h2>{f.q}</h2>
            <span class="mt-1 shrink-0 font-mono text-signal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 max-w-3xl leading-relaxed text-facility-300">{f.a}</p>
          {f.link && (
            <a href={f.link.href} class="mt-3 inline-block font-mono text-sm text-signal hover:text-signal-dim">{f.link.label} <span aria-hidden="true">→</span></a>
          )}
        </details>
      ))}
    </div>

    <div class="mt-14 flex flex-wrap gap-4">
      <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">Play free on Roblox <span aria-hidden="true">→</span></a>
      <a href={LINKS.discord} rel="noopener" target="_blank" class="btn-secondary">Ask in the Discord <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
