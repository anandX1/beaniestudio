---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS } from '../site.config';

const faqs = [
  {
    q: 'When does STATIC release?',
    a: 'STATIC targets a Q4 2026 release on Roblox. The countdown on the home page tracks the start of the launch window, and the Discord gets every schedule update first.',
  },
  {
    q: 'How much will STATIC cost?',
    a: 'Nothing — STATIC is free to play on Roblox at launch. If you have Roblox installed, you already have everything you need.',
  },
  {
    q: 'What platforms does STATIC support?',
    a: 'Mobile, PC, and console — all in the same matches. Performance is tuned to run on iPhone-8-class phones, so the whole squad plays together regardless of device.',
  },
  {
    q: 'How many players are in a match?',
    a: 'STATIC matches are 5v1: five Scrappers versus one Hunter, up to six players per round. Rounds run five to ten minutes.',
  },
  {
    q: 'What is the game about?',
    a: 'Five Scrappers salvage scrap from a wrecked shuttle while one player — the Hunter — stalks the wreck. Scrappers win by finishing the job and escaping; the Hunter is faster, stronger, and hunts entirely by sound.',
  },
  {
    q: 'How does the Hunter track players?',
    a: 'By sound alone — there is no radar and no minimap for anyone. Noises players cause, like failed repairs or mishandled heavy scrap, carry through the wreck and pull the Hunter in. Move quietly or do not move at all.',
  },
  {
    q: 'How do scrap deposits and repairs work?',
    a: 'Each match has five deposit areas with different scrap limits. Scrappers feed scrap until an area hits its limit, then complete a repair minigame to secure it. Failing the minigame makes noise the Hunter can hear.',
  },
  {
    q: 'How do you escape in STATIC?',
    a: 'Once enough deposits are secured, two exit doors power up and only one opens — and it is chosen randomly. The endgame is a race the Hunter can still ruin.',
  },
  {
    q: 'What happens if the Hunter catches me?',
    a: 'The first hit knocks you down; a second kills. Downed Scrappers crawl and can recover, but the Hunter can carry them over a shoulder to a siphon pod. Teammates see captured players highlighted and can rescue before it is too late.',
  },
  {
    q: 'Can I revive myself in STATIC?',
    a: 'Yes — a downed Scrapper who goes for a self-revive gambles it: roughly a five percent chance to get back up, otherwise they die. Calling a teammate is the safe play; the gamble is the story.',
  },
  {
    q: 'Are there classes or progression?',
    a: 'Classes arrive in the first major update — each resists or disrupts the Hunter differently, from stuns to slows. Between rounds you earn frags and coins from scrap filled, repairs, and revives, spendable on cosmetics.',
  },
  {
    q: 'Is STATIC scary or funny?',
    a: 'Both, on purpose. The hiding is genuinely tense, but ragdoll physics, shoves, and clumsy escapes turn near-misses into clips. The best rounds are terrifying right up until they are hilarious.',
  },
  {
    q: 'How can I playtest or help?',
    a: 'Join the Discord. Playtests, balance feedback, and bug reports all happen there, and regular contributors get credited in the facility.',
  },
  {
    q: 'Is STATIC on PlayStation, Xbox, or Switch?',
    a: 'STATIC runs inside Roblox, so it is on every platform Roblox is on — PlayStation, Xbox, mobile, and PC — with full crossplay in the same matches. There is no separate console download.',
  },
  {
    q: 'Can I play STATIC solo?',
    a: 'Not as designed — STATIC is built around crew dynamics. Scrappers need teammates to cover noise and haul heavy scrap, and the minimum round is two players.',
  },
  {
    q: 'Will there be a voice chat?',
    a: 'Yes — proximity voice chat is planned: you hear other Scrappers only when they are close, and loud talking is exactly as dangerous as sprinting. It is being tested in playtests before launch.',
  },
  {
    q: 'How long is a match?',
    a: 'Five to ten minutes. Rounds are built to fit between other things — one more round should never be a big decision.',
  },
  {
    q: 'Will STATIC be monetized? Are there skins or battle passes?',
    a: 'The game is free at launch. Cosmetic customization is planned, bought with in-game currency earned by playing — no pay-to-win. Nothing you can buy will make you quieter or faster.',
  },
  {
    q: 'Does the game run on older phones?',
    a: 'Yes — performance is tuned for iPhone-8-class hardware and equivalent Android devices. Low settings are the default there, and the sound design carries the horror even on small speakers. Headphones are still recommended.',
  },
  {
    q: 'Can I make videos or stream STATIC?',
    a: 'Yes — clip and monetize freely. The game is built to be clipped: ragdoll physics and clumsy escapes are half the point. Credit to Beanie Studio and a link to beaniestudio.site is appreciated, never required.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="STATIC FAQ — release date, platforms, price"
  description="Answers about STATIC: Salvage vs Hunter — release window Q4 2026, free to play, mobile/PC/console crossplay, match size, and how sound-based tracking works."
  path="/faq"
  ogImage="/og/faq.png"
  jsonLd={[faqLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq' }]}
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="kicker">Good questions, straight answers</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      Questions, answered
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      Everything we can publicly say right now. Anything not listed here is either undecided or
      being tested — the Discord hears it first.
    </p>

    <div class="mt-14 divide-y divide-facility-700 border-y border-facility-700">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-lg font-semibold uppercase tracking-wide text-facility-100 transition-colors group-open:text-signal">
            {f.q}
            <span class="mt-1 shrink-0 font-mono text-signal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 max-w-3xl leading-relaxed text-facility-300">{f.a}</p>
        </details>
      ))}
    </div>

    <div class="mt-14 flex flex-wrap gap-4">
      <a href={LINKS.discord} rel="noopener" target="_blank" class="btn-primary">Ask in the Discord <span aria-hidden="true">→</span></a>
      <a href={`mailto:${SITE.contact}`} class="btn-secondary">Email us <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
