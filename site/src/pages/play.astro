---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { SITE, LINKS } from '../site.config';
import { GAME, CRUSHERS } from '../data/game';
import { PLAY_VIDEOS, watchUrl } from '../data/videos';

const videoLd = PLAY_VIDEOS.map((v) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${v.title} — STATIC`,
  description: v.note,
  thumbnailUrl: [new URL(`/yt/${v.id}.jpg`, SITE.url).href],
  uploadDate: v.date,
  embedUrl: `https://www.youtube.com/embed/${v.id}`,
  contentUrl: watchUrl(v.id),
  publisher: { '@id': `${SITE.url}/#org` },
}));

const steps = [
  {
    n: '1',
    title: 'Open STATIC on Roblox',
    body: 'Free on PC and mobile. You need a Roblox account and the Roblox app (or a browser on PC).',
    href: LINKS.game,
    cta: 'Open the game page',
    external: true,
  },
  {
    n: '2',
    title: 'Bring a squad',
    body: `A server holds up to ${GAME.serverSize} players. Rounds are better with people you know, and the Discord is the fastest place to find a group.`,
    href: LINKS.discord,
    cta: 'Find players in the Discord',
    external: true,
  },
  {
    n: '3',
    title: 'Learn the basics in 3 minutes',
    body: `Controls, how to fill the ${CRUSHERS.totalKg} kg quota, and how to deal with Jingles and the Worm.`,
    href: '/guide/',
    cta: 'Read the beginner guide',
    external: false,
  },
];
---

<BaseLayout
  title="Play STATIC — Free Roblox Horror Game (PC & Mobile)"
  description="How to play STATIC on Roblox: free on PC and mobile, up to 7 players per server. Open the game, find a squad in the Discord, and learn the basics."
  path="/play"
  ogImage="/og/play.png"
  jsonLd={videoLd}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Play', path: '/play' }]}
>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <p class="kicker flex items-center gap-3">
      <span class="dot" aria-hidden="true"></span>
      {GAME.status} · free · {GAME.platforms.join(' + ')}
    </p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      Play STATIC
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      STATIC is free on Roblox. Play on PC or mobile, in the same servers, with up to
      {GAME.serverSize - 1} other players.
    </p>
    <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary mt-9">Play free on Roblox <span aria-hidden="true">→</span></a>

    <ol class="mt-16 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <li class="panel flex flex-col p-7">
          <span class="font-mono text-sm text-signal-dim">STEP {s.n}</span>
          <h2 class="mt-3 font-display text-xl font-bold uppercase tracking-wide">{s.title}</h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-facility-300">{s.body}</p>
          <a
            href={s.href}
            rel={s.external ? 'noopener' : undefined}
            target={s.external ? '_blank' : undefined}
            class="mt-6 font-mono text-sm text-signal hover:text-signal-dim"
          >
            {s.cta} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>

    <h2 class="mt-24 font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">See it first</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {PLAY_VIDEOS.map((v) => <VideoCard video={v} />)}
    </div>
  </section>
</BaseLayout>
