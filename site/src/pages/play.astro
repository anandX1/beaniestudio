---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import { LINKS } from '../site.config';
import { PLAY_VIDEOS, watchUrl } from '../data/videos';

const videoLd = PLAY_VIDEOS.map((v) => ({
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${v.title} — STATIC: Salvage vs Hunter`,
  description: v.note,
  thumbnailUrl: [new URL(`/yt/${v.id}.jpg`, 'https://beaniestudio.site').href],
  uploadDate: v.date,
  embedUrl: `https://www.youtube.com/embed/${v.id}`,
  contentUrl: watchUrl(v.id),
  publisher: { '@type': 'Organization', name: 'Beanie Studio', url: 'https://beaniestudio.site' },
}));

const steps = [
  {
    n: '1',
    title: 'Follow the community',
    body: 'The Roblox community page is where the game goes live. Follow it now and the round-one doors are one click away on launch day.',
    href: LINKS.roblox,
    cta: 'Open Roblox →',
  },
  {
    n: '2',
    title: 'Get in the Discord',
    body: 'Playtests, balance notes, bug reports, and the dev diaries happen here first. Founders get their names in the facility.',
    href: LINKS.discord,
    cta: 'Join Discord →',
  },
  {
    n: '3',
    title: 'Learn the loop',
    body: 'Read the mission brief so your first round isn\'t the one where you sprint past the Hunter. Your ears matter more than your aim.',
    href: '/#main',
    cta: 'Read the brief →',
  },
];
---

<BaseLayout
  title="Play STATIC — free on Roblox at launch"
  description="STATIC: Salvage vs Hunter launches on Roblox in Q4 2026 — free, crossplay, mobile-first. Follow the community and be there for round one."
  path="/play"
  ogImage="/og/play.png"
  jsonLd={videoLd}
  breadcrumb={[{ name: 'Mission brief', path: '/' }, { name: 'Play', path: '/play' }]}
>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="kicker flex items-center gap-3">
      <span class="dot" aria-hidden="true"></span>
      Status: pre-launch
    </p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      Play STATIC
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      STATIC is free on Roblox at launch — crossplay between mobile, PC, and console, tuned to run
      on iPhone-8-class phones. The doors open in Q4 2026. Here's how to be there for round one.
    </p>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <article class="panel flex flex-col p-7">
          <span class="font-mono text-sm text-signal-dim" aria-hidden="true">0{s.n}</span>
          <h2 class="mt-3 font-display text-xl font-bold uppercase tracking-wide">{s.title}</h2>
          <p class="mt-4 flex-1 text-sm leading-relaxed text-facility-300">{s.body}</p>
          <a href={s.href} class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-signal hover:text-signal-dim">
            {s.cta}
          </a>
        </article>
      ))}
    </div>

    <!-- Gameplay footage strip -->
    <section class="mt-20" aria-labelledby="footage-heading">
      <p class="kicker flex items-center gap-3">
        <span class="dot" aria-hidden="true"></span>
        Caught on camera
      </p>
      <h2 id="footage-heading" class="mt-4 font-display text-2xl font-bold uppercase tracking-wide sm:text-4xl">
        See it run before it ships
      </h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-facility-300">
        Real playtest footage from the current build — chase audio, hide-and-seek chaos, and the
        occasional betrayal. Click any card to play it right here.
      </p>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {PLAY_VIDEOS.map((v) => <VideoCard video={v} />)}
      </div>
    </section>

    <div class="panel mt-16 flex flex-col items-start justify-between gap-6 p-8 sm:flex-row sm:items-center">
      <div>
        <p class="font-display text-xl font-bold uppercase tracking-wide">Zero cost. Zero download hoops.</p>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-facility-300">
          STATIC runs inside Roblox — if you have Roblox, you have STATIC. No launcher, no key, no
          purchase at launch.
        </p>
      </div>
      <a href={LINKS.roblox} rel="noopener" target="_blank" class="btn-primary shrink-0">
        Follow on Roblox <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
