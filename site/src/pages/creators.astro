---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS } from '../site.config';
import { JINGLES, POD, WORM, EXTRACTION } from '../data/game';

const angles = [
  {
    t: 'One of your friends is the monster',
    b: 'The Hunter is a real player picked from the server each round. Hunting your own squad, or getting hunted by them, makes reactions that write themselves.',
  },
  {
    t: 'Anyone can summon the Worm',
    b: `Every Scrapper carries a bell that always brings a Worm ${WORM.bellSpawnDelaySec} seconds later. One teammate with a bell and bad intentions is a whole video.`,
  },
  {
    t: 'Built-in comebacks',
    b: `${POD.timerSec}-second pod timers, ${POD.rescueHoldSec}-second rescues and a pod overload that stuns a camping Hunter. Rounds swing late.`,
  },
  {
    t: 'An ending worth clipping',
    b: `A ${EXTRACTION.windowSec}-second dash to the ${EXTRACTION.room} and a UFO beam-out, while Jingles' Bloodlust lights everyone up every ${JINGLES.bloodlust.everySec} seconds.`,
  },
];

const faqs: [string, string][] = [
  ['Can I monetize videos and streams of STATIC?', 'Yes. Stream it, upload it and monetize it. No permission needed and no revenue share.'],
  ['Where do I get art for thumbnails?', 'The press kit has the Jingles render (transparent PNG), the key art and the studio logos, free to use.'],
  ['Can I get help or footage for a video?', `Message the team in the Discord or email ${SITE.contact}. We're a team of three, so the Discord is usually fastest.`],
  ['Is there a streamer integration?', 'It is planned: chat and stream events that trigger things inside a round while you play. It is not in the beta yet. Follow the Discord for news.'],
];
---

<BaseLayout
  title="STATIC for Creators — Stream & Make Videos"
  description="Make videos or stream STATIC on Roblox: free to monetize, ready-made art in the press kit, and the moments that make the best clips."
  path="/creators"
  ogImage="/og/creators.png"
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Creators', path: '/creators' }]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-24">
    <p class="kicker">For creators</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      Make videos of STATIC
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      STATIC is a free co-op horror game on Roblox where one player in the server hunts everyone
      else. You're free to stream, upload and monetize it. Here's what makes the best content.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/press/" class="btn-primary">Press kit &amp; art <span aria-hidden="true">→</span></a>
      <a href={LINKS.discord} rel="noopener" target="_blank" class="btn-secondary">Talk to the team <span aria-hidden="true">→</span></a>
    </div>

    <div class="mt-16 grid gap-5 sm:grid-cols-2">
      {angles.map((c) => (
        <div class="panel p-7">
          <h2 class="font-display text-lg font-bold uppercase tracking-wide">{c.t}</h2>
          <p class="mt-3 text-sm leading-relaxed text-facility-300">{c.b}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 border-t border-facility-700 pt-10">
      <h2 class="kicker">Creator FAQ</h2>
      <div class="mt-4 divide-y divide-facility-700 border-y border-facility-700">
        {faqs.map(([q, a]) => (
          <details class="group py-5" open>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-lg font-semibold uppercase tracking-wide text-facility-100 transition-colors group-open:text-signal">
              <h3>{q}</h3>
              <span class="mt-1 shrink-0 font-mono text-signal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-3xl leading-relaxed text-facility-300">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
