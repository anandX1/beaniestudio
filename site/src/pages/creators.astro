---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS } from '../site.config';

const whyCards = [
  {
    t: 'Your chat plays detective',
    b: 'The Hunter hunts by sound alone — and your stream IS the sound. Viewers hear every footstep with you, scream directions in chat, and accuse your teammates of sabotage. Horror becomes participation.',
  },
  {
    t: 'Every death is a clip',
    b: 'Five-to-ten-minute rounds, ragdoll shoves, jump-scare standoffs: the game manufactures short-form clips. Streamers keep telling us the same thing — STATIC content carries itself.',
  },
  {
    t: 'Creator effects on stream',
    b: 'Verified creators get an in-game code: your viewers trigger lights-out events, fake Hunter footsteps and louder scares while you play. Chat buys chaos — you react on camera. (Powered by Tikfinity / StreamElements keypress triggers.)',
  },
  {
    t: 'First in line, always',
    b: 'Verified creators play every build before public playtests, get a permanent Discord role, name in the game credits, and direct line to the devs for bug reports and feature asks.',
  },
];

const steps = [
  ['1 — Join the Discord', 'Apply in #creator-verification with your channel link. Any size welcome — we verify you are a real human who makes content.'],
  ['2 — Get your creator kit', 'Private build access, the effects code, clip-friendly settings guide, and a folder of b-roll for your edits.'],
  ['3 — Stream it, keep everything', 'No revenue cut, no exclusivity, no contracts. We only ask one thing: play it for real. The content sells itself.'],
];

const faqs = [
  ['Do I need a minimum follower count?', 'No. Verification is manual — we check your channel is real and active. Small streamers get the same kit as big ones.'],
  ['Which platforms count?', 'Twitch, YouTube, TikTok and Kick. If you stream STATIC live anywhere, you qualify.'],
  ['What do the viewer-triggered effects actually do?', 'Verified creators get a chat-trigger code. Viewers redeem effects — lights flicker, a decoy Hunter footstep plays, the salvage gets heavier for 10 seconds. You react; chat loses its mind. Setup takes five minutes with Tikfinity or any key-press tool.'],
  ['Is there a revenue split or contract?', 'No. Everything a creator earns from their content is 100% theirs.'],
];
---
<BaseLayout
  title="Creator program — stream STATIC, get the creator kit"
  description="Stream STATIC on Twitch, YouTube, TikTok or Kick? Get verified: private playtest builds, viewer-triggered in-game effects for your chat, clip kits, Discord role and credits. No contracts, no revenue cut."
  path="/creators"
  ogImage="/og/creators.png"
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Creator program', path: '/creators' }]}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map(([q, a]) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ]}
>
  <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 sm:py-28">
    <p class="kicker">Creator program</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl" data-decode>
      Streamers: this game was built for your chat
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      STATIC is a 5v1 horror game where the Hunter hunts by <strong class="text-facility-100">sound alone</strong>.
      That makes it one of the most streamable games on Roblox: your audience hears exactly what you hear, with
      no radar to do the thinking for them. Verified creators get effects, builds and support — free, forever.
    </p>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {whyCards.map((c) => (
        <div class="panel p-7">
          <h2 class="font-display text-lg font-bold uppercase tracking-wide">{c.t}</h2>
          <p class="mt-3 text-sm leading-relaxed text-facility-300">{c.b}</p>
        </div>
      ))}
    </div>

    <p class="kicker mt-16">How it works</p>
    <div class="mt-4 space-y-4">
      {steps.map(([t, b]) => (
        <div class="panel flex flex-col gap-2 p-6 sm:flex-row sm:items-baseline sm:gap-6">
          <h2 class="min-w-56 font-display text-base font-bold uppercase tracking-wide text-signal">{t}</h2>
          <p class="text-sm leading-relaxed text-facility-300">{b}</p>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-wrap items-center gap-4">
      <a href={LINKS.discord} class="btn-primary">Apply in Discord — #creator-verification <span aria-hidden="true">→</span></a>
      <a href="/press" class="btn-secondary">Press kit &amp; facts <span aria-hidden="true">→</span></a>
    </div>
    <p class="mt-4 font-mono text-xs tracking-[0.14em] text-facility-500">
      QUESTIONS? EMAIL {SITE.contact.toUpperCase()} — A HUMAN REPLIES.
    </p>

    <div class="mt-16 border-t border-facility-700 pt-10">
      <p class="kicker">Creator FAQ</p>
      <div class="mt-4 divide-y divide-facility-700 border-y border-facility-700">
        {faqs.map(([q, a]) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-lg font-semibold uppercase tracking-wide text-facility-100 transition-colors group-open:text-signal">
              {q}
              <span class="mt-1 shrink-0 font-mono text-signal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-4 max-w-3xl leading-relaxed text-facility-300">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
