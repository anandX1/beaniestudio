---
/**
 * /videos/<slug>/ — one watch page per official video.
 *
 * This is the single documented exception to the "video embeds are facades" rule
 * (site/CLAUDE.md #13, SEO-PLAYBOOK §4). Google only treats a video as a page's
 * main content when it can see the embed in the SERVED HTML, so the iframe is
 * emitted directly here rather than swapped in on click. The facade pattern still
 * applies everywhere else; listing pages funnel to these pages instead.
 *
 * The page's job is to host the video, so it ships the embed, the real metadata,
 * and a genuine next step (the guide pages that cover what the video shows).
 * Nothing is asserted about a video's contents beyond its own title and note.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoThumb from '../../components/VideoThumb.astro';
import { SITE, LINKS } from '../../site.config';
import { VIDEOS, embedUrlPlain, watchUrl, thumbUrl, thumbDims } from '../../data/videos';

export function getStaticPaths() {
  return VIDEOS.map((video) => ({ params: { slug: video.slug }, props: { video } }));
}

const { video } = Astro.props;
const dims = thumbDims(video.id);

const others = VIDEOS.filter((v) => v.slug !== video.slug);
const next = others.slice(0, 3);

const fmtDate = new Date(`${video.date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

interface NextStep {
  href: string;
  label: string;
  blurb: string;
  /** Off-site link — needs rel="noopener" and a new tab. */
  external?: boolean;
}

/**
 * Where to send someone after the video. Chosen by the video's own tag, so the
 * link is always genuinely related rather than a fixed boilerplate block.
 */
const NEXT_STEPS: Record<string, NextStep[]> = {
  DEVLOG: [
    { href: '/blog/', label: 'Written devlog', blurb: 'Longer posts on how STATIC is built.' },
    { href: '/press/', label: 'Press kit', blurb: 'Fact sheet, art and contact for creators.' },
  ],
  GAMEPLAY: [
    { href: '/guide/', label: "Beginner's guide", blurb: 'Roles, controls and how a round runs.' },
    { href: '/guide/map/', label: 'The map, room by room', blurb: 'Every room in the bunker.' },
  ],
  COMMUNITY: [
    { href: '/creators/', label: 'For creators', blurb: 'Making STATIC videos? Start here.' },
    { href: LINKS.discord, label: 'Discord', blurb: 'Share clips and find a squad.', external: true },
  ],
  STATIC: [
    { href: '/guide/jingles/', label: 'Jingles, the Hunter', blurb: 'The player hunting you every round.' },
    { href: '/guide/', label: "Beginner's guide", blurb: 'Roles, controls and how a round runs.' },
  ],
};
const nextSteps = NEXT_STEPS[video.tag] ?? NEXT_STEPS.STATIC;

const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  '@id': `${new URL(`/videos/${video.slug}/`, SITE.url).href}#video`,
  name: video.title,
  description: video.note,
  thumbnailUrl: [new URL(thumbUrl(video.id), SITE.url).href],
  uploadDate: video.date,
  embedUrl: embedUrlPlain(video.id),
  contentUrl: watchUrl(video.id),
  url: new URL(`/videos/${video.slug}/`, SITE.url).href,
  inLanguage: 'en',
  isFamilyFriendly: true,
  publisher: { '@id': `${SITE.url}/#org` },
  about: { '@id': `${SITE.url}/#game` },
};

// Title budget: SERP truncates ~60 chars, and BaseLayout appends the brand only
// when the total stays inside it.
const pageTitle = `${video.title} — STATIC Video`;
---

<BaseLayout
  title={pageTitle}
  description={video.note}
  path={`/videos/${video.slug}/`}
  ogImage={thumbUrl(video.id)}
  ogImageWidth={dims.w}
  ogImageHeight={dims.h}
  ogImageAlt={`${video.title} — STATIC video thumbnail`}
  ogType="article"
  jsonLd={[videoLd]}
  breadcrumb={[
    { name: 'Home', path: '/' },
    { name: 'Videos', path: '/videos' },
    { name: video.title, path: `/videos/${video.slug}` },
  ]}
>
  <article class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
    <nav aria-label="Breadcrumb" class="font-mono text-xs tracking-[0.14em] text-facility-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li class="flex items-center gap-2">
          <a href="/videos/" class="hover:text-signal">VIDEOS</a>
          <span aria-hidden="true">/</span>
        </li>
        <li><span aria-current="page" class="text-facility-300">{video.tag}</span></li>
      </ol>
    </nav>

    <p class="kicker mt-10">{video.tag} · {fmtDate.toUpperCase()}</p>
    <h1 class="mt-4 font-display text-3xl font-bold uppercase leading-tight tracking-tight sm:text-5xl">
      {video.title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-facility-300">{video.note}</p>

    <!-- The embed is in the HTML on purpose — do not convert this to a facade. -->
    <div class="shot-frame mt-10 aspect-video">
      <iframe
        src={embedUrlPlain(video.id)}
        title={`${video.title} — STATIC`}
        loading="lazy"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        class="h-full w-full border-0"
      ></iframe>
    </div>

    <p class="mt-4 font-mono text-xs tracking-[0.14em] text-facility-500">
      PLAYING FROM YOUTUBE · <a href={watchUrl(video.id)} rel="noopener" target="_blank" class="text-signal hover:text-signal-dim">OPEN ON YOUTUBE ↗</a>
    </p>

    <section aria-labelledby="next-h" class="mt-16 border-t border-facility-700 pt-10">
      <h2 id="next-h" class="font-display text-2xl font-bold uppercase tracking-wide">Keep reading</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {nextSteps.map((s) => (
          <li class="panel p-5">
            <a
              href={s.href}
              rel={s.external ? 'noopener' : undefined}
              target={s.external ? '_blank' : undefined}
              class="font-display text-lg font-bold uppercase tracking-wide hover:text-signal"
            >
              {s.label} <span aria-hidden="true">{s.external ? '↗' : '→'}</span>
            </a>
            <p class="mt-2 text-sm leading-relaxed text-facility-300">{s.blurb}</p>
          </li>
        ))}
      </ul>
    </section>
  </article>

  <section aria-labelledby="more-h" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="more-h" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">More videos</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {next.map((v) => (
          <li><VideoThumb video={v} /></li>
        ))}
      </ul>
      <p class="mt-10">
        <a href="/videos/" class="font-mono text-sm text-signal hover:text-signal-dim">All {VIDEOS.length} videos <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</BaseLayout>
