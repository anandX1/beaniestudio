---
/**
 * /videos/ — the single page for every official video.
 *
 * This replaced seven per-video watch pages. Those were built on the assumption
 * that the uploads were long-form; they are actually YouTube Shorts, 6–18 seconds
 * each. Seven ~300-word pages around 6-second clips is the thin/doorway pattern
 * Google rejects, and they measured as the thinnest pages on the site. One
 * substantive page with all seven clips carries more weight than eight thin ones,
 * so the watch pages were retired with 301s (see _redirects).
 *
 * Embeds stay as click-to-load facades (design contract rule 13): the page makes
 * zero YouTube requests until a visitor actually asks to play something.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoCard from '../../components/VideoCard.astro';
import { SITE, LINKS } from '../../site.config';
import { VIDEOS, CHANNEL_URL, watchUrl, embedUrlPlain, thumbUrl, thumbDims, isoDuration } from '../../data/videos';
import { GAME, JINGLES, CRUSHERS } from '../../data/game';

const gameplay = VIDEOS.filter((v) => v.tag !== 'DEVLOG');
const devlogs = VIDEOS.filter((v) => v.tag === 'DEVLOG');
const totalSeconds = VIDEOS.reduce((a, v) => a + v.durationSec, 0);

/** One VideoObject per clip, so the clips are machine-described even without
 *  a dedicated page each. duration is the real length, in ISO 8601. */
const videoObjects = VIDEOS.map((v) => ({
  '@type': 'VideoObject',
  '@id': `${new URL('/videos/', SITE.url).href}#${v.id}`,
  name: v.title,
  description: v.note,
  thumbnailUrl: [new URL(thumbUrl(v.id), SITE.url).href],
  uploadDate: v.date,
  duration: isoDuration(v.durationSec),
  embedUrl: embedUrlPlain(v.id),
  contentUrl: watchUrl(v.id),
  inLanguage: 'en',
  isFamilyFriendly: true,
  publisher: { '@id': `${SITE.url}/#org` },
  about: { '@id': `${SITE.url}/#game` },
}));

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'STATIC videos',
  description: `Official gameplay, devlogs and community clips from ${SITE.name}.`,
  numberOfItems: VIDEOS.length,
  itemListElement: videoObjects.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: v,
  })),
};
---

<BaseLayout
  title="STATIC Videos — Gameplay and Devlogs"
  description={`${VIDEOS.length} official STATIC clips: gameplay from inside the bunker and devlogs on how the Roblox horror game is built. Plus how a round actually works.`}
  path="/videos"
  ogImageAlt="STATIC gameplay clips and devlogs"
  jsonLd={[itemListLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Videos', path: '/videos' }]}
>
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
    <p class="kicker">Watch</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      STATIC videos
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-100">
      {GAME.name} is a free co-op horror game on Roblox. These are our own clips of it — rounds
      from inside the bunker, plus devlogs on how the game gets built.
    </p>
    <p class="mt-5 max-w-2xl leading-relaxed text-facility-300">
      They are short by design: {VIDEOS.length} clips, {totalSeconds} seconds in total. If you want
      the game explained properly rather than glimpsed, the{' '}
      <a href="/guide/" class="link">beginner guide</a> covers a full round end to end, and the{' '}
      <a href="/screenshots/" class="link">{CRUSHERS.count} crushers and every room</a> are
      documented in the screenshots and map pages.
    </p>
    <p class="mt-8 flex flex-wrap items-center gap-4">
      <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">
        Play free on Roblox <span aria-hidden="true">→</span>
      </a>
      <a href={CHANNEL_URL} rel="noopener" target="_blank" class="btn-secondary">
        Subscribe on YouTube <span aria-hidden="true">↗</span>
      </a>
    </p>
  </section>

  <section aria-labelledby="vids-devlog" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="vids-devlog" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Devlogs
      </h2>
      <p class="mt-3 max-w-2xl text-facility-300">
        How the game gets made — the menu UI, the tools, and what we got wrong. Longer reading
        lives in the <a href="/blog/" class="link">written devlog</a>.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {devlogs.map((v) => (
          <li>
            <VideoCard video={v} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="vids-gameplay" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="vids-gameplay" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Rounds and clips
      </h2>
      <p class="mt-3 max-w-2xl text-facility-300">
        What a round actually looks like, from the people who made it. {GAME.scrappers.min}–
        {GAME.scrappers.max} Scrappers against one {JINGLES.name}.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gameplay.map((v, i) => (
          <li>
            <VideoCard video={v} eager={i === 0} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="vids-next" class="atmo-amber border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
      <h2 id="vids-next" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Where to go next
      </h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { href: '/guide/', label: "Beginner's guide", blurb: 'Roles, controls and the round from lobby to extraction.' },
          { href: '/guide/jingles/', label: 'Jingles, the Hunter', blurb: 'Abilities, how it finds you, and counterplay.' },
          { href: '/guide/map/', label: 'The map', blurb: 'Every room in the bunker, with screenshots.' },
          { href: '/screenshots/', label: 'Screenshots', blurb: 'Every official capture in one gallery.' },
        ].map((s) => (
          <li class="panel p-5">
            <a href={s.href} class="font-display text-lg font-bold uppercase tracking-wide hover:text-signal">
              {s.label} <span aria-hidden="true">→</span>
            </a>
            <p class="mt-2 text-sm leading-relaxed text-facility-300">{s.blurb}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
