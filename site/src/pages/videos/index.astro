---
/**
 * /videos/ — the hub for every official STATIC video.
 *
 * This page is a router, not an embedder: each thumbnail links to its own
 * /videos/<slug>/ watch page, which is where the iframe lives in the HTML so
 * search engines can treat the video as that page's main content. Keeping the
 * embeds off this page also means the hub loads with zero third-party requests.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoThumb from '../../components/VideoThumb.astro';
import { SITE, LINKS } from '../../site.config';
import { VIDEOS, CHANNEL_URL } from '../../data/videos';
import { GAME } from '../../data/game';

const gameplay = VIDEOS.filter((v) => v.tag !== 'DEVLOG');
const devlogs = VIDEOS.filter((v) => v.tag === 'DEVLOG');

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'STATIC videos',
  description: `Official gameplay, devlogs and community clips from ${SITE.name}.`,
  numberOfItems: VIDEOS.length,
  itemListElement: VIDEOS.map((v, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: v.title,
    url: new URL(`/videos/${v.slug}/`, SITE.url).href,
  })),
};
---

<BaseLayout
  title="STATIC Videos — Gameplay and Devlogs"
  description={`Every official STATIC video in one place: gameplay from inside the bunker, devlogs on how the Roblox horror game is built, and community clips.`}
  path="/videos"
  ogImageAlt="STATIC gameplay videos and devlogs"
  jsonLd={[itemListLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Videos', path: '/videos' }]}
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="kicker">Watch</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">
      STATIC videos
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      {GAME.name} is a free co-op horror game on Roblox. These are our own videos of it —
      real rounds from inside the bunker, plus devlogs on how the game gets built.
      Every one opens on its own page with the player embedded.
    </p>
    <p class="mt-6 flex flex-wrap items-center gap-4">
      <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary">
        Play free on Roblox <span aria-hidden="true">→</span>
      </a>
      <a href={CHANNEL_URL} rel="noopener" target="_blank" class="btn-secondary">
        Subscribe on YouTube <span aria-hidden="true">↗</span>
      </a>
    </p>
  </section>

  <section aria-labelledby="vids-gameplay" class="border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="vids-gameplay" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Rounds and clips
      </h2>
      <p class="mt-3 max-w-2xl text-facility-300">What a round actually looks like, from the people who made it.</p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gameplay.map((v, i) => (
          <li>
            <VideoThumb video={v} eager={i < 3} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="vids-devlog" class="atmo-blue border-t border-facility-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <h2 id="vids-devlog" class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
        Devlogs
      </h2>
      <p class="mt-3 max-w-2xl text-facility-300">
        How the game gets made — the UI, the tools, and what we got wrong.
      </p>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {devlogs.map((v) => (
          <li>
            <VideoThumb video={v} />
          </li>
        ))}
      </ul>
      <p class="mt-10">
        <a href="/blog/" class="font-mono text-sm text-signal hover:text-signal-dim">Read the written devlog <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</BaseLayout>
