---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Signal lost"
  description="This corridor doesn't exist. Head back to the mission brief."
  path="/404"
  noindex
>
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-28">
    <p class="kicker">Error 404 — signal lost</p>
    <h1 class="mt-6 font-display text-6xl font-bold uppercase tracking-tight text-signal sm:text-8xl">
      <span class="flicker">Static</span>
    </h1>
    <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-facility-300">
      This corridor isn't on the facility map. Whatever was here is gone — and something may have
      heard you open the door.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a href="/" class="btn-primary">Back to the brief <span aria-hidden="true">→</span></a>
      <a href="/play" class="btn-secondary">How to play <span aria-hidden="true">→</span></a>
    </div>

    <!-- Hunter proximity: moving the cursor here is LOUD. Escalating status
         line + red vignette, the 404 as a two-sentence horror story. -->
    <div id="hunt404" class="panel mx-auto mt-16 max-w-md p-6 text-left" data-hunt>
      <div class="flex items-center justify-between">
        <p class="noise-label text-facility-500">Proximity monitor</p>
        <p class="noise-label text-status-green" id="hunt404State">IT HASN'T NOTICED YOU</p>
      </div>
      <div class="hunter-bar mt-3" role="meter" aria-label="Hunter proximity" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="hunt404Meter">
        <div class="hunter-bar-fill"></div>
      </div>
      <p class="mt-4 font-mono text-[0.66rem] leading-relaxed tracking-[0.14em] text-facility-500">
        MOVE YOUR CURSOR SLOWLY. THIS PAGE HAS NO OTHER EXIT.
      </p>
    </div>
  </section>

  <div class="dread-vignette" aria-hidden="true"></div>

  <script>
    (function () {
      const meter = document.getElementById('hunt404Meter');
      const stateEl = document.getElementById('hunt404State');
      if (!meter || !stateEl) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return;

      let level = 0;
      let lastT = 0;
      let lastX = 0;
      let lastY = 0;
      // Ordered highest-threshold first: find() returns the most severe state the level qualifies for.
      const STATES = [
        { at: 40, label: 'FOOTSTEPS. SOMEWHERE LEFT.', cls: 'text-signal', body: 'elevated' },
        { at: 18, label: 'IT HEARD THAT.', cls: 'text-status-red', body: 'critical' },
        { at: -1, label: "IT HASN'T NOTICED YOU", cls: 'text-status-green', body: '' },
      ];

      const render = function () {
        meter.style.setProperty('--hunt', level.toFixed(1) + '%');
        meter.setAttribute('aria-valuenow', String(Math.round(level)));
        const s = STATES.find((x) => level >= x.at) || STATES[0];
        if (stateEl.textContent !== s.label) {
          stateEl.textContent = s.label;
          stateEl.classList.remove('text-status-green', 'text-signal', 'text-status-red');
          stateEl.classList.add(s.cls);
        }
        document.body.dataset.noise = s.body;
      };

      const decay = setInterval(function () {
        level = level > 0.5 ? level * 0.82 : 0;
        render();
      }, 300);

      document.addEventListener('pointermove', function (e) {
        const dt = Math.max(24, e.timeStamp - lastT);
        const dx = e.clientX - lastX;
        const dy = e.clientY - lastY;
        lastT = e.timeStamp;
        lastX = e.clientX;
        lastY = e.clientY;
        const v = Math.hypot(dx, dy) / dt;
        if (v > 0.9) level = Math.min(100, level + Math.min(6, (v - 0.9) * 2.2));
        render();
      }, { passive: true });

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { clearInterval(decay); level = 0; render(); }
      });
    })();
  </script>
</BaseLayout>
