---
import BaseLayout from '../layouts/BaseLayout.astro';
import Shot from '../components/Shot.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE, LINKS } from '../site.config';
import { SHOTS, shot, type Shot as ShotT } from '../data/media';

const GROUPS: { key: ShotT['group'][]; title: string; intro: string }[] = [
  { key: ['jingles'], title: 'Jingles, the Hunter', intro: 'The clockwork jester every Scrapper is running from.' },
  { key: ['room', 'map'], title: 'The bunker', intro: 'Rooms of the beta map, captured in-game and in Studio.' },
  { key: ['objective', 'pod', 'worm'], title: 'Crushers, pods and the Worm', intro: 'What you feed, where you end up, and what lives under the floor.' },
  { key: ['ui'], title: 'Interface', intro: 'End-of-round screens and the mobile HUD.' },
  { key: ['round', 'hallway'], title: 'Lobby, reveal and corridors', intro: 'Before the round, and the spaces between rooms.' },
];

const sections = GROUPS.map((g) => ({ ...g, shots: SHOTS.filter((s) => g.key.includes(s.group)) })).filter((g) => g.shots.length);

const galleryLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'STATIC screenshots',
  description: 'Official screenshots of STATIC, the free co-op horror game on Roblox.',
  about: { '@id': `${SITE.url}/#game` },
  image: SHOTS.map((s) => ({
    '@type': 'ImageObject',
    contentUrl: new URL(s.full, SITE.url).href,
    description: s.alt,
    width: Math.min(1920, s.w),
    height: Math.round((Math.min(1920, s.w) / s.w) * s.h),
    creator: { '@id': `${SITE.url}/#org` },
    copyrightHolder: { '@id': `${SITE.url}/#org` },
    acquireLicensePage: new URL('/press/', SITE.url).href,
  })),
};
---

<BaseLayout
  title="STATIC Screenshots — Official Roblox Game Images"
  description={`${SHOTS.length} official screenshots of STATIC on Roblox: Jingles the Hunter, every room of the bunker, crushers, pods, the Worm and the end-of-round screens.`}
  path="/screenshots"
  ogImage={shot('cargo-dock-shuttle').full}
  ogImageAlt="The Cargo Dock in STATIC"
  jsonLd={[galleryLd]}
  breadcrumb={[{ name: 'Home', path: '/' }, { name: 'Screenshots', path: '/screenshots' }]}
>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24">
    <p class="kicker">Media</p>
    <h1 class="mt-6 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-6xl">STATIC screenshots</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-facility-300">
      {SHOTS.length} official screenshots from the beta. Click any image to see it full size. Free
      to use in videos, articles and thumbnails. High-res JPGs are in the
      <a href="/press/" class="text-signal underline decoration-signal-dim underline-offset-4 hover:text-signal-dim">press kit</a>.
    </p>

    <nav aria-label="Sections" class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-[0.14em]">
      {sections.map((g, i) => <a href={`#g${i}`} class="text-facility-300 hover:text-signal">{g.title.toUpperCase()} ({g.shots.length})</a>)}
    </nav>

    {sections.map((g, i) => (
      <section id={`g${i}`} class="mt-20 scroll-mt-24" aria-labelledby={`g${i}-h`}>
        <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-facility-700 pb-4">
          <h2 id={`g${i}-h`} class="font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">{g.title}</h2>
          <p class="text-sm text-facility-500">{g.intro}</p>
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {g.shots.map((s, j) => {
            // Feature tile only when the source is sharp enough to be shown big.
            const big = j === 0 && g.shots.length > 4 && s.w >= 1600;
            return (
              <li class:list={['reveal shot-frame aspect-[16/10]', big && 'sm:col-span-2 sm:row-span-2 sm:aspect-auto']}>
                <Shot id={s.id} lightbox="all" sizes={big ? '(min-width: 1024px) 760px, 100vw' : '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw'} imgClass="h-full w-full object-cover" />
              </li>
            );
          })}
        </ul>
      </section>
    ))}

    <div class="panel mt-24 flex flex-col gap-5 p-7 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="font-display text-xl font-bold uppercase tracking-wide">See it moving</p>
        <p class="mt-1 text-sm text-facility-300">STATIC is free on Roblox for PC and mobile.</p>
      </div>
      <a href={LINKS.game} rel="noopener" target="_blank" class="btn-primary shrink-0">Play free on Roblox <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <Lightbox />
</BaseLayout>
