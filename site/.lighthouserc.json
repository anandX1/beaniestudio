{
  "ci": {
    "collect": {
      "startServerCommand": "npx -y serve@14 dist -l 4173",
      "startServerReadyPattern": "[Ll]ocal",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/play/",
        "http://127.0.0.1:4173/faq/",
        "http://127.0.0.1:4173/press/",
        "http://127.0.0.1:4173/blog/",
        "http://127.0.0.1:4173/blog/why-we-removed-the-radar/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["performance", "seo", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "uses-responsive-images": "warn",
        "unused-javascript": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "reports"
    }
  }
}
