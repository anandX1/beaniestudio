{
  "name": "beaniestudio-site",
  "version": "2.0.0",
  "description": "Beanie Studio website — STATIC: Salvage vs Hunter (Roblox)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host ::",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node scripts/check-links.mjs",
    "audit:live": "node scripts/audit-live.mjs",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "ping:indexnow:dry": "node scripts/ping-indexnow.mjs --dry",
    "social:post": "node scripts/social-post.mjs",
    "social:seed": "node scripts/social-post.mjs --seed",
    "promo:pack": "node scripts/promo-pack.mjs",
    "engine:harvest": "node scripts/content-engine.mjs harvest",
    "engine:draft": "node scripts/content-engine.mjs draft",
    "engine:post": "node scripts/content-engine.mjs post",
    "engine:all": "node scripts/content-engine.mjs all",
    "deploy": "node scripts/deploy-site.mjs",
    "search:index": "pagefind --site dist",
    "deploy:dry": "node scripts/deploy-site.mjs --dry-run",
    "studio": "node scripts/studio.mjs",
    "seo": "npm run check:links && npm run ping:indexnow:dry"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "pagefind": "^1.5.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/public-sans": "^5.2.5",
    "@fontsource/chakra-petch": "^5.2.5",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.0",
    "tailwindcss": "^4.1.11"
  }
}
